---
import Page from '../layouts/Page.astro';
import Desk from '../components/Desk.astro';
const sections = [
	{
		id: 'hardware',
		num: '01',
		title: 'Hardware',
		items: [
			{ label: 'Mac Mini M4 / 10-core CPU, 16-core Neural Engine, silent desk powerhouse', badge: 'DAILY DRIVER' },
			{ label: 'External Monitor / IDE, terminals & telemetry dashboards side-by-side', badge: null },
			{ label: 'AirPods Pro 2 (USB-C) / Active Noise Cancellation for uninterrupted flow state', badge: 'ESSENTIAL' },
		],
	},
	{
		id: 'editor',
		num: '02',
		title: 'Editor & Terminal',
		items: [
			{ label: 'Visual Studio Code / primary development environment', badge: 'DAILY DRIVER' },
			{ label: 'GitHub Copilot / AI-assisted pair programming & inline completions', badge: 'PREFERRED' },
			{ label: 'Ghostty / ultra-fast GPU-accelerated terminal emulator written in Zig', badge: 'DAILY DRIVER' },
			{ label: 'OpenCode / terminal AI coding assistant', badge: 'OCCASIONAL' },
			{ label: 'Git + GitHub CLI (gh) / PR workflows, code reviews, release pipelines', badge: null },
			{ label: 'GitHub Copilot CLI / AI terminal assistant for complex bash & git pipelines', badge: 'PREFERRED' },
		],
	},
	{
		id: 'stack',
		num: '03',
		title: 'Engineering Stack',
		items: [
			{ label: 'TypeScript & Node.js / web platforms, tooling, and AI agent orchestration', badge: 'PREFERRED' },
			{ label: '.NET 9 / C# / high-throughput backend services and cloud platform engineering', badge: null },
			{ label: 'Docker / local development parity and microservice containerization', badge: 'ESSENTIAL' },
			{ label: 'Microsoft Azure / cloud-native architecture, Container Apps, Cosmos DB', badge: 'DAILY DRIVER' },
		],
	},
	{
		id: 'apps',
		num: '04',
		title: 'Daily Apps',
		items: [
			{ label: 'Raycast / launcher, clipboard history, window snapping, and workflow shortcuts', badge: 'FAVOURITE' },
			{ label: 'Google Chrome / primary browser and DevTools performance profiler', badge: 'DAILY DRIVER' },
			{ label: 'ChatGPT & Claude / architecture design sparring, drafting, and test generation', badge: 'DAILY DRIVER' },
			{ label: 'WhatsApp / asynchronous team, peer, and family communication', badge: null },
		],
	},
];
---
<Page title="Uses & Toolkit | Usama Ansari" description="The hardware, software, and engineering tools that power Usama Ansari's everyday work.">
  <div class="container">
    <section class="page-intro"><span class="eyebrow" data-enter>Behind the work</span><h1 class="page-title"><span class="line-reveal"><span>A workspace</span></span> <span class="line-reveal accent"><span style="--order: 1">that works.</span></span></h1><p class="page-lead" data-enter style="--order: 2">Good tools get out of the way. Here’s the hardware, software, and everyday setup that helps me stay in the flow.</p></section>
    <Desk />
    <div class="toolkit-controls" data-reveal><h2>The everyday kit.</h2><div class="filter-group" role="group" aria-label="Filter tools by usage">{[['all', 'All tools'], ['daily-driver', 'Daily driver'], ['preferred', 'Preferred'], ['essential', 'Essential'], ['favourite', 'Favourite']].map(([filter, label]) => <button type="button" class="filter-button" data-filter={filter} aria-pressed={filter === 'all'}>{label}</button>)}</div></div>
    <p class="tool-count" role="status">17 tools</p>
    <div class="toolkit-layout">
      <nav class="toolkit-nav" aria-label="Page sections">{sections.map(section => <a href={`#${section.id}`}><span>{section.num}</span>{section.title}</a>)}</nav>
      <div class="toolkit-sections">{sections.map(section => <section class="toolkit-section" id={section.id} data-reveal><h3>{section.title}</h3><ul>{section.items.map(item => <li class="tool-item" data-badge={item.badge ? item.badge.toLowerCase().replace(/\s/g, '-') : 'standard'}><div><h4>{item.label.slice(0, item.label.lastIndexOf(' / '))}</h4><p>{item.label.slice(item.label.lastIndexOf(' / ') + 3)}</p></div>{item.badge && <span class="tool-badge">{item.badge.toLowerCase()}</span>}</li>)}</ul><p class="tool-empty" hidden>No tools in this category match the selected filter.</p></section>)}</div>
    </div>
  </div>
</Page>
<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('.tool-item');
  buttons.forEach(button => button.addEventListener('click', () => {
    const filter = button.dataset.filter; let count = 0;
    buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    items.forEach(item => { item.hidden = filter !== 'all' && item.dataset.badge !== filter; if (!item.hidden) count++; });
    document.querySelector('.tool-count')!.textContent = `${count} ${count === 1 ? 'tool' : 'tools'}`;
    document.querySelectorAll('.toolkit-section').forEach(section => { section.querySelector<HTMLElement>('.tool-empty')!.hidden = Array.from(section.querySelectorAll<HTMLElement>('.tool-item')).some(item => !item.hidden); });
  }));
</script>
<style>
  .toolkit-controls { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1.5rem; padding-top: var(--space-section); }
  .toolkit-controls h2 { font-size: clamp(2rem, 3.5vw, 3rem); }
  .tool-count { color: var(--text-muted); font-size: .75rem; margin-block: 1.5rem 2rem; }
  .toolkit-layout { display: grid; grid-template-columns: 1fr 2.5fr; gap: 4rem; }
  .toolkit-nav { position: sticky; top: 7rem; align-self: start; display: grid; }
  .toolkit-nav a { display: flex; align-items: center; gap: 1rem; min-height: 48px; font-size: .85rem; }
  .toolkit-nav a:hover { color: var(--accent); }
  .toolkit-nav span { color: var(--text-muted); font-size: .65rem; }
  .toolkit-section { border-top: 1px solid var(--border); padding-top: 2rem; scroll-margin-top: 7rem; }
  .toolkit-section + .toolkit-section { margin-top: 3rem; }
  .toolkit-section h3 { font-size: 2rem; }
  .toolkit-section ul { list-style: none; margin: 1.5rem 0 0; padding: 0; display: grid; gap: 1.5rem; }
  .tool-item { display: flex; align-items: start; justify-content: space-between; gap: 2rem; padding: .5rem 0; }
  .tool-item h4 { font-family: var(--font-body); letter-spacing: -.02em; font-size: 1rem; line-height: 1.4; font-weight: 500; }
  .tool-item p { color: var(--text-muted); font-size: .85rem; margin-top: .35rem; max-width: 48ch; }
  .tool-badge { flex-shrink: 0; text-transform: capitalize; color: var(--accent); font-size: .65rem; padding: .25rem .6rem; background: var(--accent-soft); border-radius: 100px; }
  .tool-empty { padding-top: 1.5rem; color: var(--text-muted); font-size: .9rem; }
  @media (max-width: 768px) { .toolkit-layout { grid-template-columns: 1fr; gap: 2rem; } .toolkit-nav { position: static; grid-template-columns: 1fr 1fr; } .toolkit-nav a { font-size: .78rem; gap: .7rem; } }
  @media (max-width: 480px) { .tool-item { flex-direction: column; gap: .5rem; } }
</style>
