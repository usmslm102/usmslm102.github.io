---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Desk from '../components/Desk.astro';
import RouteMotion from '../components/RouteMotion.astro';
import { SITE_TITLE } from '../consts';

const sections = [
	{
		id: 'hardware',
		num: '01',
		title: 'Hardware',
		items: [
			{ label: 'Mac Mini M4 — 10-core CPU, 16-core Neural Engine, silent desk powerhouse', badge: 'DAILY DRIVER' },
			{ label: 'External Monitor — IDE, terminals & telemetry dashboards side-by-side', badge: null },
			{ label: 'AirPods Pro 2 (USB-C) — Active Noise Cancellation for uninterrupted flow state', badge: 'ESSENTIAL' },
		],
	},
	{
		id: 'editor',
		num: '02',
		title: 'Editor & Terminal',
		items: [
			{ label: 'Visual Studio Code — primary development environment', badge: 'DAILY DRIVER' },
			{ label: 'GitHub Copilot — AI-assisted pair programming & inline completions', badge: 'PREFERRED' },
			{ label: 'Ghostty — ultra-fast GPU-accelerated terminal emulator written in Zig', badge: 'DAILY DRIVER' },
			{ label: 'OpenCode — terminal AI coding assistant', badge: 'OCCASIONAL' },
			{ label: 'Git + GitHub CLI (gh) — PR workflows, code reviews, release pipelines', badge: null },
			{ label: 'GitHub Copilot CLI — AI terminal assistant for complex bash & git pipelines', badge: 'PREFERRED' },
		],
	},
	{
		id: 'stack',
		num: '03',
		title: 'Engineering Stack',
		items: [
			{ label: 'TypeScript & Node.js — web platforms, tooling, and AI agent orchestration', badge: 'PREFERRED' },
			{ label: '.NET 9 / C# — high-throughput backend services and cloud platform engineering', badge: null },
			{ label: 'Docker — local development parity and microservice containerization', badge: 'ESSENTIAL' },
			{ label: 'Microsoft Azure — cloud-native architecture, Container Apps, Cosmos DB', badge: 'DAILY DRIVER' },
		],
	},
	{
		id: 'apps',
		num: '04',
		title: 'Daily Apps',
		items: [
			{ label: 'Raycast — launcher, clipboard history, window snapping, and workflow shortcuts', badge: 'FAVOURITE' },
			{ label: 'Google Chrome — primary browser and DevTools performance profiler', badge: 'DAILY DRIVER' },
			{ label: 'ChatGPT & Claude — architecture design sparring, drafting, and test generation', badge: 'DAILY DRIVER' },
			{ label: 'WhatsApp — asynchronous team, peer, and family communication', badge: null },
		],
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Uses & Toolkit | ${SITE_TITLE}`} description="Software, hardware, and engineering toolkit used daily by Usama Ansari." />
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" class="uses-page">

			<div class="manifest-header" data-route-reveal style="--stagger: 0;">
				<div class="manifest-meta">
					<span class="manifest-label">THE PERSONAL TOOLKIT</span>
					<span class="manifest-label">HARDWARE + SOFTWARE</span>
					<span class="manifest-label">AUTHOR: USAMA ANSARI</span>
				</div>
				<h1>Tools of the trade<span style="color:var(--accent)">.</span></h1>
				<p class="tagline">
					A living inventory of the hardware, software, and engineering principles powering my systems work, writing, and daily focus. Refined over 12+ years of shipping software.
				</p>
			</div>

			<!-- Interactive Studio Workbench -->
			<Desk />

			<!-- Filter Bar for Item Manifest -->
			<div class="filter-strip" data-route-reveal style="--stagger: 1;">
				<span class="filter-title">Filter by Tier:</span>
				<div class="filter-buttons">
					<button type="button" class="filter-btn active" data-filter="all">All Items (17)</button>
					<button type="button" class="filter-btn" data-filter="daily-driver">Daily Driver</button>
					<button type="button" class="filter-btn" data-filter="preferred">Preferred</button>
					<button type="button" class="filter-btn" data-filter="essential">Essential</button>
					<button type="button" class="filter-btn" data-filter="favourite">Favourite</button>
				</div>
			</div>

			<div class="manifest-body">
				<!-- Sticky TOC Sidebar -->
				<nav class="manifest-toc" aria-label="Page sections" data-route-reveal style="--stagger: 1;">
					<p class="toc-heading">// Contents</p>
					{sections.map((s) => (
						<a href={`#${s.id}`} class="toc-link">
							<span class="toc-num">{s.num}</span>
							<span>{s.title}</span>
						</a>
					))}
				</nav>

				<!-- Manifest Sections -->
				<div class="manifest-sections">
					{sections.map((s, index) => (
						<section class="manifest-section" id={s.id} data-route-reveal style={`--stagger: ${index + 2};`}>
							<div class="section-label">
								<span class="section-num">{s.num}</span>
								<h2 class="section-title">{s.title}</h2>
							</div>
							<ul class="item-list">
								{s.items.map((item) => (
									<li class="item" data-badge={item.badge ? item.badge.toLowerCase().replace(/\s/g, '-') : 'standard'}>
										<span class="item-arrow" aria-hidden="true">→</span>
										<span class="item-label">{item.label}</span>
										{item.badge && (
											<span class:list={['badge', `badge--${item.badge.toLowerCase().replace(/\s/g, '-')}`]}>
												{item.badge}
											</span>
										)}
									</li>
								))}
							</ul>
						</section>
					))}
				</div>
			</div>
		</main>

		<script>
			import { playClickSound } from '../scripts/sound';

			const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
			const items = document.querySelectorAll<HTMLElement>('.item');

			filterBtns.forEach(btn => {
				btn.addEventListener('click', () => {
					filterBtns.forEach(b => b.classList.remove('active'));
					btn.classList.add('active');
					const filter = btn.dataset.filter;

					items.forEach(item => {
						const badge = item.dataset.badge;
						if (filter === 'all' || badge === filter) {
							item.style.display = 'flex';
						} else {
							item.style.display = 'none';
						}
					});

					playClickSound(1.2);
				});
			});
		</script>

		<RouteMotion />
		<Footer />
	</body>
</html>

<style>
	.uses-page {
		width: 100%;
		max-width: 1100px;
		margin: auto;
		padding-bottom: 5rem;
		box-sizing: border-box;
		overflow-x: hidden;
	}

	/* Manifest Header */
	.manifest-header {
		border-bottom: 1px solid rgb(var(--gray-light));
		padding-bottom: 2.25rem;
		margin-bottom: 2.5rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.manifest-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.manifest-label {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		padding: 0.25rem 0.55rem;
		border-radius: 4px;
		background: var(--surface-alt);
		border: 1px solid rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
	}

	.manifest-label:first-child {
		background: color-mix(in oklch, var(--accent-soft) 85%, white);
		color: var(--accent-dark);
		border-color: color-mix(in oklch, var(--accent) 30%, transparent);
	}

	.manifest-header h1 {
		font-size: clamp(3rem, 7vw, 5.2rem);
		line-height: 0.98;
		letter-spacing: -0.03em;
		margin: 0;
	}

	.tagline {
		max-width: 62ch;
		font-size: 1.05rem;
		line-height: 1.7;
		color: rgb(var(--gray-dark));
		margin: 0;
	}

	/* Filter Strip */
	.filter-strip {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 2.5rem;
		padding: 0.85rem 1.25rem;
		background: var(--surface-card);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		flex-wrap: wrap;
	}

	.filter-title {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: var(--ink-blue);
	}

	.filter-buttons {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.filter-btn {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		padding: 0.25rem 0.65rem;
		background: var(--surface-alt);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 20px;
		color: rgb(var(--gray-dark));
		cursor: pointer;
		transition: transform 140ms var(--ease-out), border-color 140ms var(--ease-out), color 140ms var(--ease-out), background-color 140ms var(--ease-out);
	}

	.filter-btn:active {
		transform: scale(0.97);
	}

	@media (hover: hover) and (pointer: fine) {
		.filter-btn:hover {
			border-color: var(--accent);
			color: rgb(var(--black));
		}
	}

	.filter-btn.active {
		background: rgb(var(--black));
		color: var(--surface);
		border-color: rgb(var(--black));
	}

	/* Body Layout */
	.manifest-body {
		display: grid;
		grid-template-columns: 200px 1fr;
		gap: 3.5rem;
		align-items: start;
	}

	/* TOC Sidebar */
	.manifest-toc {
		position: sticky;
		top: 6rem;
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		background: var(--surface-card);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		padding: 1.1rem;
		box-shadow: var(--shadow-sm);
	}

	.toc-heading {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		margin: 0 0 0.5rem;
		padding-bottom: 0.5rem;
		border-bottom: 1px solid rgb(var(--gray-light));
		color: var(--ink-blue);
	}

	.toc-link {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		padding: 0.35rem 0.5rem;
		font-family: var(--font-ui);
		font-size: 0.82rem;
		text-decoration: none;
		color: rgb(var(--gray-dark));
		border-radius: 4px;
		transition: color 140ms var(--ease-out), background-color 140ms var(--ease-out), transform 140ms var(--ease-out);
	}

	.toc-link:active {
		transform: scale(0.98);
	}

	@media (hover: hover) and (pointer: fine) {
		.toc-link:hover {
			background: var(--accent-soft);
			color: var(--accent-dark);
		}
	}

	.toc-num {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		color: var(--accent);
	}

	/* Sections */
	.manifest-sections {
		display: flex;
		flex-direction: column;
		gap: 2.5rem;
		min-width: 0;
	}

	.manifest-section {
		border-bottom: 1px solid rgb(var(--gray-light));
		padding-bottom: 2.5rem;
		scroll-margin-top: 6rem;
	}

	.manifest-section:last-child {
		border-bottom: none;
	}

	.section-label {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		margin-bottom: 1.25rem;
	}

	.section-num {
		font-family: var(--font-mono);
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--accent);
	}

	.section-title {
		font-family: var(--font-display);
		font-size: clamp(1.8rem, 3.5vw, 2.3rem);
		font-weight: 700;
		letter-spacing: -0.025em;
		margin: 0;
	}

	/* Item List */
	.item-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.item {
		display: flex;
		align-items: baseline;
		gap: 0.75rem;
		padding: 0.75rem 0.85rem;
		background: var(--surface-card);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		font-size: 0.94rem;
		line-height: 1.6;
		transition: transform 160ms var(--ease-out), border-color 160ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.item:hover {
			transform: translateX(3px);
			border-color: var(--accent);
		}
	}

	.item-arrow {
		color: var(--accent);
		font-size: 0.8rem;
		font-weight: 700;
		flex-shrink: 0;
	}

	.item-label {
		flex: 1;
		color: rgb(var(--black));
	}

	.badge {
		font-family: var(--font-mono);
		font-size: 0.62rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		padding: 0.15rem 0.45rem;
		border-radius: 4px;
		white-space: nowrap;
		flex-shrink: 0;
		border: 1px solid transparent;
	}

	.badge--daily-driver {
		background: color-mix(in oklch, var(--ink-blue-soft) 85%, white);
		border-color: color-mix(in oklch, var(--ink-blue) 30%, transparent);
		color: var(--ink-blue);
	}

	.badge--favourite {
		background: var(--accent);
		color: var(--surface);
		border-color: var(--accent-dark);
	}

	.badge--essential {
		background: color-mix(in oklch, var(--success-soft) 80%, white);
		border-color: color-mix(in oklch, var(--success) 35%, transparent);
		color: oklch(0.28 0.08 158);
	}

	.badge--preferred {
		background: var(--surface-alt);
		border-color: rgb(var(--gray-light));
		color: rgb(var(--gray-dark));
	}

	.badge--occasional {
		background: var(--surface-alt);
		border-color: rgb(var(--gray-light));
		color: rgb(var(--gray));
	}

	/* Responsive */
	@media (max-width: 820px) {
		.manifest-body {
			grid-template-columns: 1fr;
			gap: 2rem;
		}

		.manifest-toc {
			position: static;
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0.5rem;
		}

		.toc-heading {
			width: 100%;
		}
	}

	@media (max-width: 580px) {
		.manifest-header h1 {
			font-size: clamp(2.4rem, 10vw, 3.4rem);
		}

		.item {
			flex-wrap: wrap;
			gap: 0.4rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.item {
			transition: none !important;
			transform: none !important;
		}
		.item:hover {
			transform: none !important;
		}
	}
</style>
