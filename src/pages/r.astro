---
import Page from '../layouts/Page.astro';
const PDF_URL = '/Resumes_Usama_12yrs.pdf';
---
<Page title="Resume & Curriculum Vitae | Usama Ansari" description="Usama Ansari's experience in distributed systems, AI platforms, and Microsoft Azure. View or download the full résumé.">
  <div class="container">
    <section class="page-intro"><span class="eyebrow" data-enter>The experience behind the work</span><h1 class="page-title"><span class="line-reveal"><span>A little context.</span></span> <span class="line-reveal accent"><span style="--order: 1">A lot of building.</span></span></h1><p class="page-lead" data-enter style="--order: 2">12+ years in cloud architecture, AI agent platforms, and high-throughput systems. Here’s the full picture.</p><div class="button-row" data-enter style="--order: 3"><a href={PDF_URL} download class="button" data-resume-download>Download PDF résumé <span aria-hidden="true">↓</span></a><a class="text-link" href={PDF_URL} target="_blank" rel="noreferrer">Open in a new tab <span aria-hidden="true">↗</span></a><span class="status" data-download-feedback role="status"></span></div></section>
    <section class="resume-viewer" aria-label="Resume PDF preview" data-reveal><div class="viewer-toolbar"><span>Usama Ansari</span><span>Curriculum vitae · PDF</span></div><object data={`${PDF_URL}#view=FitH&navpanes=0`} type="application/pdf" title="Usama Ansari's résumé" class="pdf-frame"><div class="pdf-fallback"><h2>Take the full story with you.</h2><p>Your browser can open the résumé as a separate PDF.</p><a href={PDF_URL} target="_blank" rel="noreferrer" class="button">Open résumé PDF ↗</a></div></object></section>
    <p class="resume-note">Prefer a quick overview? <a href="/about">Explore my career timeline ↗</a></p>
  </div>
</Page>
<script>
  document.querySelector('[data-resume-download]')?.addEventListener('click', () => { document.querySelector('[data-download-feedback]')!.textContent = 'Download started.'; });
</script>
<style>
  .page-title { max-width: 18ch; font-size: clamp(3rem, 7.5vw, 7rem); }
  .resume-viewer { border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; background: var(--surface-alt); }
  .viewer-toolbar { display: flex; justify-content: space-between; gap: 1rem; padding: 1.25rem 1.5rem; font-size: .8rem; border-bottom: 1px solid var(--border); }
  .viewer-toolbar span:last-child { color: var(--text-muted); }
  .pdf-frame { display: block; width: 100%; height: 1000px; max-height: 110dvh; border: 0; }
  .pdf-fallback { padding: 4rem 2rem; }
  .pdf-fallback h2 { font-size: 2rem; }
  .pdf-fallback p { margin-block: 1rem 1.5rem; color: var(--text-body); }
  .resume-note { text-align: center; margin-top: 1.5rem; color: var(--text-muted); font-size: .85rem; }
  .resume-note a { color: var(--accent); display: inline-block; padding-block: .5rem; }
  @media (max-width: 640px) { .pdf-frame { height: 640px; } .viewer-toolbar { font-size: .7rem; padding: 1rem; } }
</style>
