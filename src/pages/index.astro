---
import { ArrowUpRight, Command } from '@lucide/astro';
import { getCollection } from 'astro:content';
import Page from '../layouts/Page.astro';
import MotionSculpture from '../components/MotionSculpture.astro';
import PersonalProjects from '../components/PersonalProjects.astro';
import FormattedDate from '../components/FormattedDate.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 3);
---
<Page title="Usama Ansari | Distributed Systems & AI Platform Architect" description="I'm Usama, a senior software engineer at Microsoft. I build distributed systems, AI agent platforms, and thoughtful open-source tools.">
  <div class="container">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="hero-intro" data-enter>Usama Ansari <span>/</span> Senior Software Engineer</p>
        <h1 id="hero-title"><span class="line-reveal"><span style="--order: 1">Engineering.</span></span> <span class="line-reveal accent"><span style="--order: 2">In motion.</span></span></h1>
        <p class="hero-description" data-enter style="--order: 3">I build distributed systems and AI platforms at Microsoft Azure, and open-source tools for everyday problems.</p>
        <div class="button-row" data-enter style="--order: 4"><a class="button" href="#projects">Explore my work <ArrowUpRight class="icon arrow" aria-hidden="true" /></a><a class="text-link" href="/about">About me <ArrowUpRight class="icon arrow" aria-hidden="true" /></a></div>
      </div>
      <div class="hero-art" data-enter style="--order: 2"><MotionSculpture /></div>
    </section>
    <section class="focus-strip" aria-label="Areas of practice" data-enter style="--order: 5">
      <span>Thinking in systems.<br /><strong>Building for people.</strong></span>
      <p>Distributed systems</p><p>AI agent platforms</p><p>Open-source tools</p>
    </section>
    <section class="work-intro" aria-label="Selected engineering work" data-reveal>
      <div><span class="eyebrow">A closer look</span><h2>From the idea<br /><span class="accent">to the details.</span></h2></div>
      <div><p>Explore the problems, architecture, and trade-offs behind an AI agent platform and a local-first finance tool.</p><a href="/work" class="text-link">Read the case studies <ArrowUpRight class="icon arrow" aria-hidden="true" /></a></div>
    </section>
    <PersonalProjects />
    <section class="practice-section section-space" aria-labelledby="practice-title">
      <div class="practice-statement" data-reveal>
        <span class="eyebrow">The bigger picture</span>
        <h2 id="practice-title">Complexity is inevitable.<br /><span class="accent">Clarity is a choice.</span></h2>
        <p>From planetary-scale telemetry to tools on your desktop, I care about the same things: thoughtful architecture, reliable foundations, and the people using them.</p>
        <a class="text-link" href="/about">My experience & approach <ArrowUpRight class="icon arrow" aria-hidden="true" /></a>
      </div>
      <div class="practice-list">
        <article data-reveal><span class="practice-index">01</span><div><h3>Intelligent platforms</h3><p>AI agents, MCP tooling, and multi-model orchestration. Designed to work together, built for the real world.</p></div></article>
        <article data-reveal><span class="practice-index">02</span><div><h3>Systems at scale</h3><p>High-availability APIs processing 150 million requests daily across more than 3 million Azure nodes.</p></div></article>
        <article data-reveal><span class="practice-index">03</span><div><h3>Software with care</h3><p>Secure integrations, practical developer tools, and a little extra attention to the details that matter.</p></div></article>
      </div>
    </section>
    <section class="writing-section section-space" id="writing" aria-labelledby="writing-title">
      <div class="section-head" data-reveal><h2 id="writing-title">Notes from<br />the build.</h2><a href="/blog" class="text-link">All writing <ArrowUpRight class="icon arrow" aria-hidden="true" /></a></div>
      <div class="writing-list">{posts.map((post, index) => <a href={`/blog/${post.id}/`} class="writing-row" data-reveal><span class="writing-number">0{index + 1}</span><div><span class="writing-date"><FormattedDate date={post.data.pubDate} /></span><h3>{post.data.title}</h3></div><ArrowUpRight class="icon writing-arrow arrow" aria-hidden="true" /></a>)}</div>
    </section>
    <a href="/uses" class="workbench-link" data-reveal>
      <div><span class="eyebrow">Behind the work</span><h2>Good tools.<br />Better headspace.</h2><p>The hardware, software, and small preferences that keep me building.</p><span class="text-link">Explore my setup <ArrowUpRight class="icon arrow" aria-hidden="true" /></span></div>
      <div class="key-composition" aria-hidden="true"><span class="key key-command"><Command class="icon" aria-hidden="true" /></span><span class="key key-k">K</span><span class="key key-arrow"><ArrowUpRight class="icon" aria-hidden="true" /></span></div>
    </a>
  </div>
</Page>
<style>
  .hero { display: grid; grid-template-columns: 1.15fr 1fr; align-items: center; gap: 1rem; padding-block: 5rem 4rem; min-height: 660px; }
  .hero-copy { position: relative; z-index: 1; }
  .hero-intro { font-size: .87rem; color: var(--text-body); margin-bottom: 2.5rem; }
  .hero-intro span { color: var(--accent); padding-inline: .65rem; }
  h1 { font-size: clamp(4rem, 7.8vw, 7.35rem); line-height: .99; font-weight: 600; letter-spacing: -.06em; }
  .hero-description { color: var(--text-body); font-size: clamp(1rem, 1.4vw, 1.17rem); line-height: 1.7; margin-block: 2rem; max-width: 43ch; }
  .hero-art { margin-inline: -1rem; }
  .focus-strip { display: grid; grid-template-columns: 1.2fr 1fr 1fr 1fr; align-items: center; gap: 2rem; border-block: 1px solid var(--border); padding-block: 1.75rem; font-size: .88rem; }
  .focus-strip > span { color: var(--text-muted); line-height: 1.5; font-size: .78rem; }
  .focus-strip strong { font-weight: 400; color: var(--text); }
  .focus-strip p { text-align: right; }
  .work-intro { display: grid; grid-template-columns: 1.15fr 1fr; align-items: end; gap: 3rem; padding-block: var(--space-section); border-bottom: 1px solid var(--border); }
  .work-intro h2 { font-size: clamp(2.5rem, 4.2vw, 4rem); }
  .work-intro p { max-width: 46ch; color: var(--text-body); margin-bottom: 1rem; }
  .practice-section { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(3rem, 8vw, 8rem); border-bottom: 1px solid var(--border); }
  .practice-statement h2 { font-size: clamp(2.5rem, 4.2vw, 4rem); max-width: 18ch; }
  .practice-statement > p { color: var(--text-body); margin-block: 2rem 1rem; max-width: 43ch; }
  .practice-list article { display: flex; gap: 1.5rem; padding-block: 2rem; border-bottom: 1px solid var(--border); }
  .practice-list article:first-child { padding-top: 0; }
  .practice-list article:last-child { border-bottom: 0; padding-bottom: 0; }
  .practice-index { color: var(--accent); font-size: .75rem; padding-top: .45rem; }
  .practice-list h3 { font-size: 1.75rem; margin-bottom: .75rem; }
  .practice-list p { color: var(--text-body); font-size: .9rem; }
  .writing-section { padding-bottom: 6rem; }
  .writing-row { display: grid; grid-template-columns: 56px 1fr 64px; gap: 1.5rem; align-items: center; padding-block: 2rem; border-top: 1px solid var(--border); }
  .writing-number { color: var(--text-muted); font-size: .75rem; }
  .writing-date { color: var(--text-muted); font-size: .74rem; }
  .writing-row h3 { font-size: clamp(1.4rem, 2.6vw, 2.2rem); max-width: 32ch; margin-top: .5rem; transition: color 200ms; }
  .writing-arrow { justify-self: end; font-size: 2rem; color: var(--accent); }
  .writing-row:hover h3 { color: var(--accent); }
  .workbench-link { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; background: var(--surface-alt); padding: clamp(2rem, 5vw, 5rem); border-radius: var(--radius); overflow: hidden; }
  .workbench-link h2 { font-size: clamp(2.7rem, 4.2vw, 4rem); }
  .workbench-link p { max-width: 35ch; color: var(--text-body); margin-block: 1.5rem 1rem; }
  .key-composition { position: relative; height: 270px; perspective: 900px; transform: rotate(-14deg); transition: transform 700ms var(--ease-out); }
  .key { position: absolute; width: 140px; height: 140px; display: grid; place-items: center; font-size: 5rem; font-weight: 500; line-height: 1; border-radius: 24px; background: var(--surface-card); box-shadow: 0 12px 0 var(--surface-sunken), 0 20px 30px #141d4020, inset 0 0 0 2px var(--border); transform: rotateX(25deg) rotateY(-15deg); }
  .key-command { top: 70px; left: 10px; }
  .key-k { top: 20px; left: 160px; background: var(--accent); color: var(--on-accent); box-shadow: 0 12px 0 var(--accent-hover), 0 24px 30px #141d4020; }
  .key-arrow { top: 160px; left: 210px; width: 100px; height: 100px; font-size: 3.5rem; }
  .workbench-link:hover .key-composition { transform: rotate(-8deg) translateY(-8px); }
  @media (max-width: 1024px) { .hero { min-height: 600px; } h1 { font-size: 7.6vw; } .key-composition { transform: rotate(-14deg) scale(.8); transform-origin: center; } }
  @media (max-width: 768px) {
    .hero { grid-template-columns: 1fr; padding-top: 3.5rem; gap: 1rem; }
    h1 { font-size: clamp(4rem, 11.8vw, 6.5rem); }
    .hero-intro { margin-bottom: 2rem; }
    .hero-art { width: min(100%, 470px); margin: -1rem auto 0; }
    .focus-strip { grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    .focus-strip p { text-align: left; }
    .work-intro { display: grid; grid-template-columns: 1.15fr 1fr; align-items: end; gap: 3rem; padding-block: var(--space-section); border-bottom: 1px solid var(--border); }
  .work-intro h2 { font-size: clamp(2.5rem, 4.2vw, 4rem); }
  .work-intro p { max-width: 46ch; color: var(--text-body); margin-bottom: 1rem; }
  .practice-section { grid-template-columns: 1fr; gap: 3rem; }
    .workbench-link { grid-template-columns: 1fr; gap: 0; }
    .key-composition { width: 340px; max-width: 100%; margin-inline: auto; transform: rotate(-14deg) scale(.85); }
  }
  @media (max-width: 380px) { h1 { font-size: 11.6vw; } .hero-intro { font-size: .72rem; } .hero-intro span { padding-inline: .3rem; } .writing-row { grid-template-columns: 1fr 32px; gap: 1rem; } .writing-number { display: none; } .key-composition { transform: rotate(-14deg) scale(.7); transform-origin: left center; } }
</style>
