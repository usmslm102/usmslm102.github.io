---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RouteMotion from '../components/RouteMotion.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`About & Career Timeline | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" class="about-page">
			<section class="intro" data-route-reveal style="--stagger: 0;">
				<div class="intro-eyebrow">
					<span class="pulsing-dot" aria-hidden="true"></span>
					<span>ARCHITECT & BUILDER</span>
				</div>
				<h1>About Usama<span style="color:var(--accent)">.</span></h1>
				<p class="lead-bio">
					Senior Software Engineer with 12.3+ years of experience designing and delivering planetary-scale distributed systems on Microsoft Azure.
				</p>
				<p class="sub-bio">
					I specialize in AI agent platform engineering, Model Context Protocol (MCP) integration, multi-model orchestration, high-availability telemetry APIs (150M+ requests/day), and resilient cloud-native security.
				</p>
			</section>

			<!-- Career Milestones Timeline -->
			<section data-route-reveal style="--stagger: 1;" class="timeline-section" aria-label="Career Timeline">
				<div class="timeline-head">
					<span class="timeline-eyebrow">CHRONOLOGY</span>
					<h2>Career Milestones</h2>
				</div>

				<ol class="timeline">
					<li class="timeline-item" data-route-reveal style="--stagger: 2;">
						<div class="period">
							<span class="period-badge">CURRENT // 2016 — PRESENT</span>
						</div>
						<div class="card current-role-card">
							<div class="role-header">
								<div>
									<h3>Microsoft — Software Engineer 2</h3>
									<p class="meta">Azure Networking & Cloud Infrastructure • Hyderabad, India</p>
								</div>
								<span class="role-tag">9+ YRS AT MSFT</span>
							</div>

							<ul class="role-bullets">
								<li>
									<strong>Azure Networking AI Agent Platform:</strong> Architected the platform with MCP (Model Context Protocol) support, dynamic memory management, multi-model orchestration (GPT-5.2 and GPT-mini), automated evaluation pipelines, and enterprise security controls.
								</li>
								<li>
									<strong>Cloud-Native Architecture:</strong> Designed on Azure AI Foundry, Azure Container Apps, and Azure Cosmos DB (operational state and vector memory), leading foundational decisions on observability, persistence, and secure integration.
								</li>
								<li>
									<strong>Early Adoption & Scale:</strong> Enabled platform adoption with 10+ production agents, 52 active internal teams, 16K-20K API requests monthly, and ~712 million tokens processed per month.
								</li>
								<li>
									<strong>Device Health API Platform:</strong> Designed and scaled a multi-region high-throughput telemetry API platform processing 150 million requests/day with 99.99%-99.999% reliability, monitoring device health across more than 3 million Azure physical nodes globally.
								</li>
								<li>
									<strong>Net Assist Dynamic Automation:</strong> Implemented schema-driven dynamic tooling for network operations, cutting per-workflow engineering effort by up to one full week.
								</li>
								<li>
									<strong>S360 Security SPOC:</strong> Owned enterprise security, compliance, vulnerability remediation, and proactive threat model reviews for AI Agent Platform and Device Health services.
								</li>
								<li>
									<strong>Architecture Mentorship:</strong> Primary SME driving design reviews and mentoring engineers on scalable, resilient cloud systems.
								</li>
							</ul>
						</div>
					</li>

					<li class="timeline-item" data-route-reveal style="--stagger: 3;">
						<div class="period">
							<span class="period-badge">NOV 2013 — APR 2016</span>
						</div>
						<div class="card">
							<div class="role-header">
								<div>
									<h3>Capgemini — Software Engineer</h3>
									<p class="meta">Enterprise Web Solutions • Mumbai, India</p>
								</div>
								<span class="role-tag">2.5 YRS</span>
							</div>
							<ul class="role-bullets">
								<li>
									Built enterprise-grade web applications for Abbott and SCA using .NET, C#, SQL Server, and Microsoft Azure cloud services.
								</li>
								<li>
									Led end-to-end delivery across requirements analysis, software architecture, unit testing, and production support.
								</li>
							</ul>
						</div>
					</li>

					<li class="timeline-item" data-route-reveal style="--stagger: 4;">
						<div class="period">
							<span class="period-badge">GRADUATED JUL 2013</span>
						</div>
						<div class="card education-card">
							<h3>Bachelor of Science in Information Technology</h3>
							<p class="meta">Mumbai University • First Class with Distinction</p>
						</div>
					</li>
				</ol>
			</section>
		</main>
		<RouteMotion />
		<Footer />
	</body>
</html>

<style>
	.about-page {
		max-width: 900px;
		width: 100%;
		margin: auto;
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
		padding-top: 3.5rem;
		box-sizing: border-box;
	}

	.intro {
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
		border-bottom: 1px solid rgb(var(--gray-light));
		padding-bottom: 2rem;
	}

	.intro-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--ink-blue);
		background: color-mix(in oklch, var(--ink-blue-soft) 85%, white);
		border: 1px solid color-mix(in oklch, var(--ink-blue) 25%, transparent);
		padding: 0.25rem 0.6rem;
		border-radius: 20px;
		width: fit-content;
	}

	.about-page h1 {
		font-size: clamp(2.8rem, 6vw, 4.4rem);
		line-height: 1.05;
		margin: 0;
	}

	.lead-bio {
		font-size: 1.18rem;
		line-height: 1.7;
		color: rgb(var(--black));
		margin: 0;
		max-width: 65ch;
	}

	.sub-bio {
		font-size: 1.02rem;
		line-height: 1.7;
		color: rgb(var(--gray-dark));
		margin: 0;
		max-width: 65ch;
	}

	/* Timeline Section */
	.timeline-section {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.timeline-head {
		border-bottom: 1px solid rgb(var(--black));
		padding-bottom: 0.75rem;
	}

	.timeline-eyebrow {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.1em;
		color: var(--ink-blue);
		display: block;
		margin-bottom: 0.2rem;
	}

	.timeline-head h2 {
		margin: 0;
		font-size: clamp(1.8rem, 3.5vw, 2.4rem);
	}

	.timeline {
		list-style: none;
		margin: 0;
		padding: 0 0 0 1.25rem;
		border-left: 2px solid color-mix(in oklch, var(--accent) 35%, rgb(var(--gray-light)));
		display: flex;
		flex-direction: column;
		gap: 2.25rem;
	}

	.timeline-item {
		position: relative;
		padding-left: 1.25rem;
	}

	.timeline-item::before {
		content: '';
		position: absolute;
		left: -1.75rem;
		top: 0.45rem;
		width: 14px;
		height: 14px;
		border-radius: 50%;
		background: var(--surface);
		border: 3px solid var(--accent);
		box-shadow: 0 0 0 4px var(--accent-glow);
	}

	.timeline-item:nth-child(2)::before {
		border-color: var(--ink-blue);
		box-shadow: none;
	}

	.timeline-item:nth-child(3)::before {
		border-color: var(--success);
		box-shadow: none;
	}

	.period {
		margin-bottom: 0.75rem;
	}

	.period-badge {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		color: var(--ink-blue);
		background: var(--surface-card);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		padding: 0.2rem 0.5rem;
	}

	.card {
		background: var(--surface-card);
		border: 1px solid color-mix(in oklch, var(--ink-blue) 20%, rgb(var(--gray-light)));
		border-radius: 10px;
		padding: 1.75rem;
		box-shadow: var(--shadow-sm);
		transition: transform 180ms var(--ease-out), border-color 180ms var(--ease-out), box-shadow 180ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.card:hover {
			transform: translateY(-2px);
			border-color: var(--accent);
			box-shadow: var(--shadow-md);
		}
	}

	.current-role-card {
		border-left: 4px solid var(--accent);
	}

	.role-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		border-bottom: 1px solid rgb(var(--gray-light));
		padding-bottom: 0.85rem;
		margin-bottom: 1.25rem;
		flex-wrap: wrap;
	}

	.card h3 {
		margin: 0 0 0.25rem;
		font-size: clamp(1.3rem, 2.5vw, 1.65rem);
		color: rgb(var(--black));
	}

	.meta {
		margin: 0;
		font-size: 0.88rem;
		color: rgb(var(--gray));
		font-family: var(--font-mono);
	}

	.role-tag {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 700;
		color: var(--accent-dark);
		background: var(--accent-soft);
		border: 1px solid color-mix(in oklch, var(--accent) 30%, transparent);
		padding: 0.2rem 0.55rem;
		border-radius: 4px;
	}

	.role-bullets {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		font-size: 0.94rem;
		line-height: 1.65;
		color: rgb(var(--gray-dark));
	}

	.role-bullets li {
		position: relative;
		padding-left: 1.25rem;
	}

	.role-bullets li::before {
		content: '▹';
		position: absolute;
		left: 0;
		color: var(--accent);
		font-weight: 700;
	}

	.role-bullets strong {
		color: rgb(var(--black));
	}

	.education-card h3 {
		font-size: 1.2rem;
		margin-bottom: 0.35rem;
	}

	@media (max-width: 600px) {
		.about-page {
			padding-top: 1.75rem;
		}

		.card {
			padding: 1.25rem;
		}

		.timeline {
			padding-left: 0.75rem;
		}

		.timeline-item::before {
			left: -1.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card {
			transition: none !important;
			transform: none !important;
		}
		.card:hover {
			transform: none !important;
		}
	}
</style>
