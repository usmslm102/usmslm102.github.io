---
import { getCollection } from 'astro:content';
import Page from '../../layouts/Page.astro';
import FormattedDate from '../../components/FormattedDate.astro';
const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const categories: Record<string, string> = {
  'containerizing-angular-application-for-production-using-docker': 'Docker',
  'create-deploy-azure-function-using-vs-code-and-azure-devops-ci-cd': 'Azure',
  'git-cheat-sheet': 'Git', 'top-visual-studio-code-extensions': 'Tooling',
};
---
<Page title="Writing & Engineering Notes | Usama Ansari" description="Practical essays, architecture patterns, and production guides on Docker, Azure, Git, and developer tools by Usama Ansari.">
  <div class="container">
    <section class="page-intro"><span class="eyebrow" data-enter>The notebook</span><h1 class="page-title"><span class="line-reveal"><span>Learn. Build.</span></span> <span class="line-reveal accent"><span style="--order: 1">Write it down.</span></span></h1><p class="page-lead" data-enter style="--order: 2">Notes on the tools, patterns, and lessons that make us better engineers.</p></section>
    <section class="blog-controls" aria-label="Search and filter articles" data-enter style="--order: 3">
      <div class="search-wrap"><label for="post-search" class="sr-only">Search articles</label><input id="post-search" type="search" placeholder="Find something worth reading…" autocomplete="off" /><button id="clear-search-btn" type="button" aria-label="Clear search" hidden>×</button><span class="search-shortcut" aria-hidden="true">/</span></div>
      <div class="filter-group" role="group" aria-label="Filter by topic">{[['all', 'All topics'], ['docker', 'Docker'], ['azure', 'Azure'], ['tooling', 'VS Code'], ['git', 'Git']].map(([topic, label]) => <button class="filter-button topic-tag" type="button" data-topic={topic} aria-pressed={topic === 'all'}>{label}</button>)}</div>
    </section>
    <p id="search-count" class="search-count" role="status">{posts.length} articles</p>
    <div id="no-results" hidden><h2>No matches, yet.</h2><p>Try a different keyword or explore the whole notebook.</p><button id="reset-filter-btn" class="button secondary" type="button">Reset search filters</button></div>
    <section class="posts-list" aria-label="Blog posts">{posts.map((post, i) => {
      const category = categories[post.id] || 'Engineering';
      const readTime = Math.max(1, Math.ceil((post.body || '').split(/\s+/).length / 220));
      return <article class="post-item" data-post data-category={category.toLowerCase()} data-search={`${post.data.title} ${post.data.description} ${category} ${post.body}`.toLowerCase()} data-reveal>
        <div class="post-number">0{i + 1}</div>
        <div class="post-copy"><div class="post-meta"><span class="post-category">{category}</span><FormattedDate date={post.data.pubDate} /><span>{readTime} min read</span></div><h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>{post.data.description !== post.data.title && <p>{post.data.description}</p>}</div>
        <a class="post-open" href={`/blog/${post.id}/`} aria-label={`Read ${post.data.title}`}><span class="arrow" aria-hidden="true">↗</span></a>
      </article>;
    })}</section>
    <div class="rss-note" data-reveal><p>A good feed never needs an algorithm.</p><a href="/rss.xml" class="text-link">Subscribe via RSS <span aria-hidden="true">↗</span></a></div>
  </div>
</Page>
<script>
  const input = document.querySelector<HTMLInputElement>('#post-search')!;
  const clear = document.querySelector<HTMLButtonElement>('#clear-search-btn')!;
  const items = Array.from(document.querySelectorAll<HTMLElement>('[data-post]'));
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-topic]');
  let topic = 'all';
  function filter() {
    const query = input.value.toLowerCase().trim(); let count = 0;
    items.forEach(item => { item.hidden = !(topic === 'all' || item.dataset.category === topic) || !item.dataset.search?.includes(query); if (!item.hidden) count++; });
    document.querySelector('#search-count')!.textContent = `${count} ${count === 1 ? 'article' : 'articles'}`;
    document.querySelector<HTMLElement>('#no-results')!.hidden = count > 0;
    clear.hidden = !query;
    buttons.forEach(button => button.setAttribute('aria-pressed', String(button.dataset.topic === topic)));
  }
  input.addEventListener('input', filter);
  clear.addEventListener('click', () => { input.value = ''; filter(); input.focus(); });
  buttons.forEach(button => button.addEventListener('click', () => { topic = button.dataset.topic!; filter(); }));
  document.querySelector('#reset-filter-btn')?.addEventListener('click', () => { topic = 'all'; input.value = ''; filter(); input.focus(); });
  document.addEventListener('keydown', event => {
    const target = event.target as HTMLElement;
    if (event.key === '/' && !event.metaKey && !event.ctrlKey && !event.altKey && !target.matches('input, textarea, select, [contenteditable="true"]') && !document.querySelector('dialog[open]')) { event.preventDefault(); input.focus(); }
  });
</script>
<style>
  .page-title { max-width: 17ch; }
  .blog-controls { display: flex; justify-content: space-between; align-items: center; gap: 2rem; border-top: 1px solid var(--border); padding-top: 2rem; }
  .search-wrap { position: relative; width: min(100%, 450px); }
  #post-search { width: 100%; padding: .85rem 4.5rem .85rem 1.2rem; border: 1px solid var(--border); border-radius: 100px; background: var(--surface-card); color: var(--text); font-size: .85rem; min-height: 50px; }
  #post-search::placeholder { color: var(--text-muted); }
  .search-shortcut { position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-muted); font-size: .8rem; }
  #clear-search-btn { position: absolute; right: 1.8rem; top: 4px; width: 40px; height: 40px; border: 0; background: transparent; font-size: 1.25rem; }
  .search-count { margin-block: 1.5rem 2rem; color: var(--text-muted); font-size: .75rem; }
  .post-item { display: grid; grid-template-columns: 70px 1fr 64px; gap: 2rem; border-top: 1px solid var(--border); padding-block: 2.5rem; }
  .post-number { font-size: .8rem; color: var(--text-muted); padding-top: .2rem; }
  .post-meta { display: flex; flex-wrap: wrap; gap: 1.25rem; font-size: .75rem; color: var(--text-muted); }
  .post-category { color: var(--accent); }
  .post-item h2 { font-size: clamp(1.8rem, 3.4vw, 3.2rem); max-width: 28ch; margin-top: 1rem; }
  .post-item h2 a:hover { color: var(--accent); }
  .post-copy > p { color: var(--text-body); margin-top: 1rem; font-size: .95rem; max-width: 65ch; }
  .post-open { align-self: center; justify-self: end; display: grid; place-items: center; width: 56px; height: 56px; border: 1px solid var(--border); border-radius: 50%; color: var(--accent); font-size: 1.6rem; }
  .rss-note { display: flex; justify-content: space-between; gap: 2rem; align-items: center; background: var(--surface-alt); border-radius: var(--radius); padding: 2rem; margin-top: 3rem; }
  .rss-note p { font-size: .95rem; color: var(--text-body); }
  #no-results { padding: 4rem 0; }
  #no-results h2 { font-size: 2.5rem; }
  #no-results p { margin-block: 1rem 1.5rem; color: var(--text-body); }
  @media (max-width: 1024px) { .blog-controls { flex-direction: column; align-items: start; gap: 1rem; } .search-wrap { width: 100%; } }
  @media (max-width: 640px) { .post-item { grid-template-columns: 1fr 44px; gap: .75rem; } .post-number { display: none; } .post-meta { gap: .6rem 1rem; font-size: .7rem; } .post-open { width: 44px; height: 44px; } .rss-note { flex-direction: column; gap: 1rem; align-items: start; } }
</style>
