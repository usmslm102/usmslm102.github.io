---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import RouteMotion from '../../components/RouteMotion.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Map categories and reading time estimates
const postMeta: Record<string, { category: string; readTime: string }> = {
	'containerizing-angular-application-for-production-using-docker': {
		category: 'Docker',
		readTime: '4 min read'
	},
	'create-deploy-azure-function-using-vs-code-and-azure-devops-ci-cd': {
		category: 'Azure',
		readTime: '9 min read'
	},
	'git-cheat-sheet': {
		category: 'Git',
		readTime: '3 min read'
	},
	'top-visual-studio-code-extensions': {
		category: 'Tooling',
		readTime: '5 min read'
	}
};
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Writing & Engineering Notes | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" class="blog-container">
			<!-- Header Intro -->
			<section class="blog-intro" data-route-reveal style="--stagger: 0;">
				<div class="intro-eyebrow">
					<span class="pulsing-dot" aria-hidden="true"></span>
					<span>ENGINEERING ARCHIVES</span>
				</div>
				<h1>Notes from the build.</h1>
				<p class="intro-subtitle">
					Practical essays, architecture patterns, and battle-tested production guides from 12+ years of shipping cloud systems.
				</p>
			</section>

			<!-- Interactive Search & Filter Bar -->
			<section class="blog-controls" aria-label="Search and filter articles" data-route-reveal style="--stagger: 1;">
				<div class="search-wrap">
					<svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
					<input
						id="post-search"
						type="search"
						placeholder="Search Docker, Azure, Git, VS Code… (press / to focus)"
						aria-label="Search articles"
						autocomplete="off"
					/>
					<button type="button" id="clear-search-btn" class="clear-btn" aria-label="Clear search" hidden>✕</button>
				</div>

				<!-- Topic filter tags -->
				<div class="filter-tags" role="group" aria-label="Filter by topic">
					<button type="button" class="topic-tag active" data-topic="all">All Topics (4)</button>
					<button type="button" class="topic-tag" data-topic="docker">Docker</button>
					<button type="button" class="topic-tag" data-topic="azure">Azure</button>
					<button type="button" class="topic-tag" data-topic="tooling">VS Code</button>
					<button type="button" class="topic-tag" data-topic="git">Git</button>
				</div>

				<div class="search-status-bar">
					<p id="search-count" role="status" class="search-count">4 posts</p>
				</div>
			</section>

			<!-- Empty State -->
			<div id="no-results" class="no-results-box" hidden aria-live="polite">
				<span class="no-results-icon">
					<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="11" cy="11" r="8"></circle>
						<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
					</svg>
				</span>
				<h3>No matching articles found</h3>
				<p>Try searching for a different keyword or reset the filter to explore all guides.</p>
				<button type="button" id="reset-filter-btn" class="reset-btn">Reset search filters</button>
			</div>

			<!-- Posts List (retains [data-post] for smoke-test compatibility) -->
			<section aria-label="Blog posts" class="posts-section">
				<ul class="posts-grid">
					{
						posts.map((post, index) => {
							const meta = postMeta[post.id] || { category: 'Engineering', readTime: '5 min read' };
							return (
								<li
									data-post
									data-category={meta.category.toLowerCase()}
									data-search={`${post.data.title} ${post.data.description} ${meta.category} ${post.body ?? ''}`.toLowerCase()}
									data-route-reveal
									style={`--stagger: ${index + 2};`}
									class="post-item"
								>
									<article class:list={['post-card', { 'with-image': !!post.data.heroImage }]}>
										{post.data.heroImage && (
											<a href={`/blog/${post.id}/`} class="post-thumb-link" tabindex="-1" aria-hidden="true">
												<Image width={480} height={270} src={post.data.heroImage} alt="" class="post-thumb" />
											</a>
										)}
										<div class="post-content">
											<div class="post-header-meta">
												<span class="category-chip">{meta.category}</span>
												<span class="meta-separator">•</span>
												<span class="date-chip">
													<FormattedDate date={post.data.pubDate} />
												</span>
												<span class="meta-separator">•</span>
												<span class="read-time-chip">{meta.readTime}</span>
												{index === 0 && <span class="fresh-pill">LATEST</span>}
											</div>

											<h2 class="title">
												<a href={`/blog/${post.id}/`}>{post.data.title}</a>
											</h2>

											<p class="description">{post.data.description}</p>

											<div class="post-footer">
												<a href={`/blog/${post.id}/`} class="read-more-link">
													Read complete guide <span aria-hidden="true">→</span>
												</a>
											</div>
										</div>
									</article>
								</li>
							);
						})
					}
				</ul>
			</section>
		</main>

		<script>
			import { playClickSound } from '../../scripts/sound';

			const searchInput = document.getElementById('post-search') as HTMLInputElement | null;
			const clearBtn = document.getElementById('clear-search-btn') as HTMLButtonElement | null;
			const topicButtons = document.querySelectorAll<HTMLButtonElement>('.topic-tag');
			const postItems = document.querySelectorAll<HTMLElement>('[data-post]');
			const countDisplay = document.getElementById('search-count');
			const noResults = document.getElementById('no-results');
			const resetBtn = document.getElementById('reset-filter-btn');

			let activeTopic = 'all';
			let searchQuery = '';

			function filterArticles() {
				let visibleCount = 0;
				const q = searchQuery.toLowerCase().trim();

				postItems.forEach((item) => {
					const category = (item.dataset.category || '').toLowerCase();
					const searchText = (item.dataset.search || '').toLowerCase();

					const matchesTopic = activeTopic === 'all' || category === activeTopic;
					const matchesSearch = !q || searchText.includes(q);

					if (matchesTopic && matchesSearch) {
						item.hidden = false;
						visibleCount++;
					} else {
						item.hidden = true;
					}
				});

				if (countDisplay) {
					countDisplay.textContent = `${visibleCount} ${visibleCount === 1 ? 'post' : 'posts'}`;
				}

				if (noResults) {
					noResults.hidden = visibleCount > 0;
				}

				if (clearBtn) {
					clearBtn.hidden = !q;
				}
			}

			// Keyboard shortcut: '/' focuses search input
			window.addEventListener('keydown', (e) => {
				if (e.key === '/' && document.activeElement !== searchInput) {
					e.preventDefault();
					searchInput?.focus();
				}
			});

			searchInput?.addEventListener('input', () => {
				searchQuery = searchInput.value;
				filterArticles();
			});

			clearBtn?.addEventListener('click', () => {
				if (searchInput) searchInput.value = '';
				searchQuery = '';
				filterArticles();
				searchInput?.focus();
				playClickSound(1.1);
			});

			topicButtons.forEach((btn) => {
				btn.addEventListener('click', () => {
					topicButtons.forEach((b) => b.classList.remove('active'));
					btn.classList.add('active');
					activeTopic = btn.dataset.topic || 'all';
					filterArticles();
					playClickSound(1.2);
				});
			});

			resetBtn?.addEventListener('click', () => {
				if (searchInput) searchInput.value = '';
				searchQuery = '';
				activeTopic = 'all';
				topicButtons.forEach((b) => b.classList.toggle('active', b.dataset.topic === 'all'));
				filterArticles();
				playClickSound(1.1);
			});
		</script>

		<RouteMotion />
		<Footer />
	</body>
</html>

<style>
	.blog-container {
		max-width: 900px;
		width: 100%;
		margin: auto;
		display: flex;
		flex-direction: column;
		gap: 3.5rem;
		padding-top: 3rem;
		padding-bottom: 5rem;
		box-sizing: border-box;
	}

	.blog-intro {
		display: flex;
		flex-direction: column;
		gap: 1rem;
		border-bottom: 1px solid var(--border);
		padding-bottom: 2.25rem;
	}

	.intro-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--pastel-blue-text);
		background: var(--pastel-blue);
		padding: 0.25rem 0.65rem;
		border-radius: 9999px;
		width: fit-content;
	}

	.blog-intro h1 {
		font-family: var(--font-serif);
		font-size: clamp(2.8rem, 6vw, 4.2rem);
		line-height: 1.05;
		margin: 0;
		font-weight: 500;
		letter-spacing: -0.035em;
	}

	.intro-subtitle {
		font-size: 1.08rem;
		line-height: 1.68;
		color: var(--text-body);
		max-width: 60ch;
		margin: 0;
	}

	/* Controls: Search & Filter Tags */
	.blog-controls {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.search-wrap {
		position: relative;
		display: flex;
		align-items: center;
		width: 100%;
	}

	.search-icon {
		position: absolute;
		left: 1rem;
		color: var(--text-muted);
		pointer-events: none;
	}

	#post-search {
		width: 100%;
		padding: 0.85rem 2.5rem 0.85rem 2.65rem;
		background: var(--surface-card);
		border: 1px solid var(--border);
		border-radius: 6px;
		font-size: 0.94rem;
		font-family: var(--font-ui);
		color: #111111;
		box-shadow: var(--shadow-sm);
		transition: border-color 140ms ease;
	}

	#post-search:focus {
		border-color: #111111;
		outline: none;
	}

	.clear-btn {
		position: absolute;
		right: 0.85rem;
		background: var(--surface-alt);
		border: 1px solid var(--border);
		border-radius: 50%;
		width: 22px;
		height: 22px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 0.68rem;
		color: var(--text-muted);
		cursor: pointer;
		transition: background-color 120ms var(--ease-out), color 120ms var(--ease-out);
	}

	.clear-btn:active {
		transform: scale(0.92);
	}

	@media (hover: hover) and (pointer: fine) {
		.clear-btn:hover {
			color: #111111;
			background: var(--surface-card);
		}
	}

	.filter-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
	}

	.topic-tag {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		padding: 0.25rem 0.65rem;
		background: var(--surface-card);
		border: 1px solid var(--border);
		border-radius: 4px;
		color: var(--text-body);
		cursor: pointer;
		transition: border-color 140ms var(--ease-out), color 140ms var(--ease-out), background-color 140ms var(--ease-out);
	}

	.topic-tag:active {
		transform: scale(0.98);
	}

	@media (hover: hover) and (pointer: fine) {
		.topic-tag:hover {
			border-color: #111111;
			color: #111111;
		}
	}

	.topic-tag.active {
		background: #111111;
		color: #FFFFFF;
		border-color: #111111;
	}

	.search-status-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.search-count {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--text-muted);
		margin: 0;
	}

	/* Empty State */
	.no-results-box {
		background: var(--surface-card);
		border: 1px dashed var(--border);
		border-radius: 8px;
		padding: 3rem 1.5rem;
		text-align: center;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.no-results-icon {
		color: var(--text-muted);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.no-results-box h3 {
		font-family: var(--font-serif);
		font-size: 1.35rem;
		font-weight: 500;
		margin: 0;
	}

	.no-results-box p {
		font-size: 0.92rem;
		color: var(--text-muted);
		margin: 0;
		max-width: 42ch;
	}

	.reset-btn {
		margin-top: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		padding: 0.45rem 0.9rem;
		background: var(--surface-alt);
		border: 1px solid var(--border);
		border-radius: 4px;
		color: #111111;
		cursor: pointer;
		transition: border-color 140ms var(--ease-out), background-color 140ms var(--ease-out);
	}

	.reset-btn:active {
		transform: scale(0.98);
	}

	@media (hover: hover) and (pointer: fine) {
		.reset-btn:hover {
			background: #111111;
			color: #FFFFFF;
			border-color: #111111;
		}
	}

	/* Posts List */
	.posts-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.post-item {
		width: 100%;
	}

	.post-card {
		background: var(--surface-card);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 1.6rem 1.8rem;
		box-shadow: var(--shadow-sm);
		transition: border-color 140ms var(--ease-out), box-shadow 140ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.post-card:hover {
			border-color: var(--border-dark);
			box-shadow: var(--shadow-hover);
		}
	}

	.post-card.with-image {
		display: grid;
		grid-template-columns: 240px 1fr;
		gap: 1.75rem;
		align-items: start;
	}

	.post-thumb {
		width: 100%;
		height: auto;
		border-radius: 4px;
		border: 1px solid var(--border);
		object-fit: cover;
		aspect-ratio: 16 / 9;
	}

	.post-content {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
	}

	.post-header-meta {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-muted);
		flex-wrap: wrap;
	}

	.category-chip {
		color: var(--pastel-blue-text);
		background: var(--pastel-blue);
		padding: 0.12rem 0.45rem;
		border-radius: 9999px;
		font-weight: 600;
		font-size: 0.62rem;
		letter-spacing: 0.04em;
	}

	.meta-separator {
		color: var(--border);
	}

	.fresh-pill {
		border: 1px solid var(--pastel-green-text);
		color: var(--pastel-green-text);
		background: var(--pastel-green);
		font-size: 0.6rem;
		font-weight: 600;
		padding: 0.08rem 0.35rem;
		border-radius: 9999px;
		letter-spacing: 0.05em;
	}

	.title {
		margin: 0.2rem 0;
		font-family: var(--font-serif);
		font-size: clamp(1.35rem, 2.5vw, 1.85rem);
		line-height: 1.22;
		font-weight: 500;
	}

	.title a {
		text-decoration: none;
		color: #111111;
		transition: opacity 140ms ease;
	}

	.post-card:hover .title a {
		opacity: 0.75;
		text-decoration: none;
	}

	.description {
		margin: 0;
		font-size: 0.94rem;
		line-height: 1.65;
		color: var(--text-body);
	}

	.post-footer {
		margin-top: 0.4rem;
	}

	.read-more-link {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		font-weight: 500;
		color: #111111;
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		transition: gap 140ms var(--ease-out);
	}

	.read-more-link:active {
		transform: scale(0.98);
	}

	@media (hover: hover) and (pointer: fine) {
		.read-more-link:hover {
			gap: 0.5rem;
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 3px;
		}
	}

	@media (max-width: 760px) {
		.blog-container {
			padding-top: 1.75rem;
		}

		.post-card.with-image {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.post-card {
			padding: 1.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.post-card {
			transition: none !important;
		}
	}
</style>
