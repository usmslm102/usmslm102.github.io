---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import RouteMotion from '../components/RouteMotion.astro';
import { CONTACT_EMAIL, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Contact & Connect | ${SITE_TITLE}`} description="Get in touch with Usama Ansari for distributed systems, cloud architecture, and AI agent engineering conversations." />
	</head>
	<body>
		<Header />
		<main id="main-content" tabindex="-1" class="contact-page">
			<section class="contact-shell" data-route-reveal style="--stagger: 0;">
				<div class="contact-eyebrow">
					<span class="pulsing-dot" aria-hidden="true"></span>
					<span>INITIATE CONNECTION</span>
				</div>

				<h1>Let’s talk systems.</h1>

				<p class="contact-lead">
					Always interested in discussing distributed systems, cloud-native telemetry, autonomous AI agent platforms, and software craftsmanship.
				</p>

				<div class="contact-cards-grid">
					<!-- Email Card -->
					<div class="contact-card email-card">
						<div class="card-icon">
							<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
								<polyline points="22,6 12,13 2,6"></polyline>
							</svg>
						</div>
						<div class="card-info">
							<span class="card-kicker">DIRECT INBOX</span>
							<h3 class="card-value">{CONTACT_EMAIL}</h3>
							<p class="card-sub">Best for architecture inquiries, consulting, or technical discussions.</p>
						</div>
						<div class="contact-actions">
							<button class="copy-email-btn" type="button" data-copy-email data-email={CONTACT_EMAIL}>
								Copy email address
							</button>
							<a href={`mailto:${CONTACT_EMAIL}`} class="mailto-btn">Open email client ↗</a>
							<span class="copy-feedback" data-copy-feedback aria-live="polite" role="status"></span>
						</div>
					</div>

					<!-- Social Networks -->
					<div class="social-channels">
						<a href="https://www.linkedin.com/in/usamaansari/" target="_blank" rel="noreferrer" class="social-card">
							<span class="social-icon">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
									<rect x="2" y="9" width="4" height="12"></rect>
									<circle cx="4" cy="4" r="2"></circle>
								</svg>
							</span>
							<div class="social-info">
								<span class="social-platform">LinkedIn</span>
								<span class="social-handle">in/usamaansari</span>
							</div>
							<span class="social-arrow">↗</span>
						</a>

						<a href="https://github.com/usmslm102" target="_blank" rel="noreferrer" class="social-card">
							<span class="social-icon">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
									<path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
								</svg>
							</span>
							<div class="social-info">
								<span class="social-platform">GitHub</span>
								<span class="social-handle">@usmslm102</span>
							</div>
							<span class="social-arrow">↗</span>
						</a>

						<a href="https://x.com/usmslm102" target="_blank" rel="noreferrer" class="social-card">
							<span class="social-icon">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
									<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
								</svg>
							</span>
							<div class="social-info">
								<span class="social-platform">X (Twitter)</span>
								<span class="social-handle">@usmslm102</span>
							</div>
							<span class="social-arrow">↗</span>
						</a>
					</div>
				</div>
			</section>
		</main>

		<script is:inline>
			const copyButton = document.querySelector('[data-copy-email]');
			const copyFeedback = document.querySelector('[data-copy-feedback]');
			const feedbackMessages = ['Copied to clipboard. Looking forward to connecting!', 'Email address copied.'];

			const setFeedback = (message, success) => {
				if (!copyFeedback) return;
				copyFeedback.textContent = message;
				copyFeedback.dataset.state = success ? 'success' : 'error';
				window.setTimeout(() => {
					copyFeedback.textContent = '';
					delete copyFeedback.dataset.state;
				}, 2400);
			};

			copyButton?.addEventListener('click', async () => {
				const email = copyButton.getAttribute('data-email');
				if (!email || !copyFeedback) return;

				if (!navigator.clipboard || !window.isSecureContext) {
					try {
						const textArea = document.createElement('textarea');
						textArea.value = email;
						textArea.style.position = 'fixed';
						textArea.style.opacity = '0';
						document.body.appendChild(textArea);
						textArea.focus();
						textArea.select();
						const successful = document.execCommand('copy');
						document.body.removeChild(textArea);
						if (successful) {
							setFeedback(feedbackMessages[0], true);
						} else {
							setFeedback('Copy unavailable. Select email text manually.', false);
						}
					} catch {
						setFeedback('Copy failed. Select email manually.', false);
					}
					return;
				}

				try {
					await navigator.clipboard.writeText(email);
					setFeedback(feedbackMessages[Math.floor(Math.random() * feedbackMessages.length)], true);
				} catch {
					setFeedback('Clipboard access was blocked.', false);
				}
			});
		</script>
		<RouteMotion />
		<Footer />
	</body>
</html>

<style>
	.contact-page {
		max-width: 860px;
		width: 100%;
		margin: auto;
		padding-top: 3rem;
		padding-bottom: 5rem;
		box-sizing: border-box;
	}

	.contact-shell {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.contact-eyebrow {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.06em;
		color: var(--pastel-blue-text);
		background: var(--pastel-blue);
		padding: 0.25rem 0.65rem;
		border-radius: 9999px;
		width: fit-content;
	}

	.contact-shell h1 {
		font-family: var(--font-serif);
		font-size: clamp(2.8rem, 6vw, 4.2rem);
		line-height: 1.05;
		margin: 0;
		font-weight: 500;
		letter-spacing: -0.035em;
	}

	.contact-lead {
		font-size: 1.12rem;
		line-height: 1.68;
		color: var(--text-body);
		margin: 0 0 1rem;
		max-width: 60ch;
	}

	.contact-cards-grid {
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.email-card {
		background: var(--surface-card);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 1.85rem;
		box-shadow: var(--shadow-sm);
		display: flex;
		flex-direction: column;
		gap: 1rem;
		transition: border-color 140ms var(--ease-out), box-shadow 140ms var(--ease-out);
	}

	.email-card:hover {
		border-color: var(--border-dark);
		box-shadow: var(--shadow-hover);
	}

	.card-icon {
		color: var(--text-muted);
		display: flex;
		align-items: center;
	}

	.card-kicker {
		font-family: var(--font-mono);
		font-size: 0.65rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		display: block;
		margin-bottom: 0.35rem;
	}

	.card-value {
		font-size: clamp(1.4rem, 3.5vw, 2rem);
		font-family: var(--font-ui);
		font-weight: 600;
		color: #111111;
		margin: 0 0 0.4rem;
		letter-spacing: -0.01em;
	}

	.card-sub {
		font-size: 0.92rem;
		color: var(--text-muted);
		margin: 0;
	}

	.contact-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.65rem;
		margin-top: 0.5rem;
	}

	.copy-email-btn {
		background: #111111;
		color: #FFFFFF;
		border: 1px solid #111111;
		border-radius: 4px;
		padding: 0.6rem 1.15rem;
		font-family: var(--font-ui);
		font-size: 0.84rem;
		font-weight: 500;
		cursor: pointer;
		transition: background-color 140ms var(--ease-out), transform 140ms var(--ease-out);
	}

	.copy-email-btn:active {
		transform: scale(0.98);
	}

	@media (hover: hover) and (pointer: fine) {
		.copy-email-btn:hover {
			background: #2F3437;
			border-color: #2F3437;
		}
	}

	.mailto-btn {
		display: inline-flex;
		align-items: center;
		padding: 0.6rem 1.15rem;
		border-radius: 4px;
		background: var(--surface-alt);
		border: 1px solid var(--border);
		color: #111111;
		font-family: var(--font-ui);
		font-size: 0.84rem;
		font-weight: 500;
		text-decoration: none;
		transition: background-color 140ms var(--ease-out), border-color 140ms var(--ease-out);
	}

	.mailto-btn:active {
		transform: scale(0.98);
	}

	@media (hover: hover) and (pointer: fine) {
		.mailto-btn:hover {
			background: var(--surface-card);
			border-color: #111111;
			text-decoration: none;
		}
	}

	.copy-feedback {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	.copy-feedback[data-state='success'] {
		color: var(--pastel-green-text);
	}

	.copy-feedback[data-state='error'] {
		color: var(--pastel-red-text);
	}

	/* Social Channels */
	.social-channels {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.social-card {
		background: var(--surface-card);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 1.15rem 1.25rem;
		text-decoration: none;
		color: inherit;
		display: flex;
		align-items: center;
		gap: 0.75rem;
		box-shadow: var(--shadow-sm);
		transition: border-color 140ms var(--ease-out), box-shadow 140ms var(--ease-out);
	}

	.social-card:active {
		transform: scale(0.98);
	}

	@media (hover: hover) and (pointer: fine) {
		.social-card:hover {
			border-color: var(--border-dark);
			box-shadow: var(--shadow-hover);
			background: var(--surface-card);
			text-decoration: none;
		}
	}

	.social-icon {
		display: flex;
		align-items: center;
		color: var(--text-muted);
	}

	.social-card:hover .social-icon {
		color: #111111;
	}

	.social-info {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		flex: 1;
	}

	.social-platform {
		font-family: var(--font-ui);
		font-size: 0.9rem;
		font-weight: 600;
		color: #111111;
	}

	.social-handle {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-muted);
	}

	.social-arrow {
		font-family: var(--font-mono);
		font-size: 0.85rem;
		color: var(--text-muted);
	}

	.social-card:hover .social-arrow {
		color: #111111;
	}

	@media (max-width: 680px) {
		.contact-page {
			padding-top: 1.75rem;
		}

		.social-channels {
			grid-template-columns: 1fr;
		}

		.email-card {
			padding: 1.25rem;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.email-card,
		.social-card,
		.copy-email-btn {
			transition: none !important;
		}
	}
</style>
