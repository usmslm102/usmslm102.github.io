---
import Page from '../layouts/Page.astro';
import { CONTACT_EMAIL } from '../consts';
const socials = [['GitHub', '@usmslm102', 'Code, experiments, and things I’m building.', 'https://github.com/usmslm102'], ['LinkedIn', 'Usama Ansari', 'Experience, work, and professional connections.', 'https://www.linkedin.com/in/usamaansari/'], ['X', '@usmslm102', 'Ideas and conversations along the way.', 'https://x.com/usmslm102']];
---
<Page title="Contact & Connect | Usama Ansari" description="Get in touch with Usama Ansari to talk about distributed systems, AI platforms, or building something interesting.">
  <div class="container contact-page">
    <section class="page-intro"><span class="eyebrow" data-enter>Start a conversation</span><h1 class="page-title"><span class="line-reveal"><span>Good things start</span></span> <span class="line-reveal accent"><span style="--order: 1">with a hello.</span></span></h1><p class="page-lead" data-enter style="--order: 2">An interesting challenge, a shared curiosity, or a simple introduction. I’d love to hear from you.</p></section>
    <section class="email-section" aria-label="Email" data-reveal>
      <span class="email-label">The best way to reach me</span>
      <a class="email-address" href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}<span class="arrow" aria-hidden="true">↗</span></a>
      <div class="email-actions"><button class="button secondary" type="button" data-copy-email data-email={CONTACT_EMAIL}>Copy email address <span aria-hidden="true">↗</span></button><span class="status" data-copy-feedback role="status" aria-live="polite"></span></div>
    </section>
    <section class="social-section" aria-labelledby="social-title"><h2 id="social-title" data-reveal>Elsewhere<br />on the internet.</h2><div class="social-list">{socials.map(([name, handle, description, href]) => <a class="social-row" href={href} target="_blank" rel="noreferrer" data-reveal><div><h3>{name}</h3><p>{description}</p></div><span class="social-handle">{handle}</span><span class="arrow" aria-hidden="true">↗</span></a>)}</div></section>
  </div>
</Page>
<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy-email]');
  const feedback = document.querySelector<HTMLElement>('[data-copy-feedback]');
  button?.addEventListener('click', async () => {
    if (!feedback) return;
    try { await navigator.clipboard.writeText(button.dataset.email!); feedback.textContent = 'Copied. Talk soon!'; }
    catch { feedback.textContent = 'Select the address above to copy it, or click it to send an email.'; }
  });
</script>
<style>
  .contact-page .page-title { max-width: 17ch; font-size: clamp(3.2rem, 7.8vw, 7.5rem); }
  .email-section { padding-block: 2.5rem 3rem; border-block: 1px solid var(--border); }
  .email-label { font-size: .82rem; color: var(--text-muted); }
  .email-address { display: flex; align-items: center; justify-content: space-between; gap: 1rem; font-family: var(--font-display); font-size: clamp(1.35rem, 4.9vw, 4.75rem); font-weight: 500; letter-spacing: -.045em; color: var(--accent); padding-block: 1rem 1.5rem; }
  .email-address .arrow { flex-shrink: 0; }
  .email-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1.5rem; }
  .social-section { display: grid; grid-template-columns: 1fr 1.7fr; gap: 4rem; padding-top: var(--space-section); }
  .social-section h2 { font-size: clamp(2.5rem, 4vw, 3.5rem); }
  .social-row { display: grid; grid-template-columns: 1fr auto 32px; align-items: center; gap: 1.5rem; padding-block: 1.75rem; border-bottom: 1px solid var(--border); }
  .social-row:first-child { padding-top: 0; }
  .social-row h3 { font-size: 1.8rem; }
  .social-row p { color: var(--text-muted); font-size: .8rem; margin-top: .6rem; }
  .social-handle { color: var(--text-muted); font-size: .75rem; }
  .social-row .arrow { font-size: 1.8rem; color: var(--accent); }
  .social-row:hover h3 { color: var(--accent); }
  @media (max-width: 768px) { .social-section { grid-template-columns: 1fr; gap: 3rem; } }
  @media (max-width: 480px) { .social-row { grid-template-columns: 1fr 32px; } .social-handle { display: none; } .email-address { font-size: 5.4vw; } }
</style>
