---
import { CONTACT_EMAIL } from '../consts';
---

<dialog id="command-palette" class="cmd-dialog" aria-label="Command Palette">
  <div class="cmd-box">
    <div class="cmd-search-wrap">
      <svg class="cmd-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input
        type="search"
        id="cmd-input"
        class="cmd-input"
        placeholder="Type a command or search (e.g. blog, docker, uses)..."
        autocomplete="off"
        spellcheck="false"
      />
      <kbd class="cmd-esc-hint">ESC</kbd>
    </div>

    <div class="cmd-results" role="listbox" id="cmd-listbox">
      <!-- Section: Navigation -->
      <div class="cmd-group" data-group="pages">
        <span class="cmd-group-title">Pages</span>
        <a href="/" class="cmd-item" role="option" data-keyword="home index main">
          <span class="cmd-item-icon">⌂</span>
          <span class="cmd-item-label">Home</span>
          <span class="cmd-item-badge">Page</span>
        </a>
        <a href="/blog" class="cmd-item" role="option" data-keyword="blog writing posts articles notes essays">
          <span class="cmd-item-icon">✎</span>
          <span class="cmd-item-label">Blog & Writing</span>
          <span class="cmd-item-badge">4 Posts</span>
        </a>
        <a href="/uses" class="cmd-item" role="option" data-keyword="uses tools hardware software stack setup mac mini ghostty">
          <span class="cmd-item-icon">⚡</span>
          <span class="cmd-item-label">Uses & Toolkit</span>
          <span class="cmd-item-badge">Setup</span>
        </a>
        <a href="/about" class="cmd-item" role="option" data-keyword="about bio career timeline experience microsoft capgemini">
          <span class="cmd-item-icon">👤</span>
          <span class="cmd-item-label">About & Career</span>
          <span class="cmd-item-badge">12.3+ Yrs</span>
        </a>
        <a href="/r" class="cmd-item" role="option" data-keyword="resume cv pdf experience download">
          <span class="cmd-item-icon">📄</span>
          <span class="cmd-item-label">Resume PDF</span>
          <span class="cmd-item-badge">Viewer</span>
        </a>
        <a href="/contact" class="cmd-item" role="option" data-keyword="contact email hello message social connect">
          <span class="cmd-item-icon">✉</span>
          <span class="cmd-item-label">Contact</span>
          <span class="cmd-item-badge">Reach Out</span>
        </a>
      </div>

      <!-- Section: Recent Posts -->
      <div class="cmd-group" data-group="posts">
        <span class="cmd-group-title">Articles</span>
        <a href="/blog/top-visual-studio-code-extensions/" class="cmd-item" role="option" data-keyword="vscode visual studio code extensions productivity editor">
          <span class="cmd-item-icon">✦</span>
          <span class="cmd-item-label">Top Visual Studio Code Extensions</span>
          <span class="cmd-item-badge">Tooling</span>
        </a>
        <a href="/blog/git-cheat-sheet/" class="cmd-item" role="option" data-keyword="git cheat sheet version control rebase commit branch">
          <span class="cmd-item-icon">✦</span>
          <span class="cmd-item-label">Git Cheat Sheet</span>
          <span class="cmd-item-badge">Git</span>
        </a>
        <a href="/blog/containerizing-angular-application-for-production-using-docker/" class="cmd-item" role="option" data-keyword="docker container angular devops containers production">
          <span class="cmd-item-icon">✦</span>
          <span class="cmd-item-label">Containerizing Angular with Docker</span>
          <span class="cmd-item-badge">Docker</span>
        </a>
        <a href="/blog/create-deploy-azure-function-using-vs-code-and-azure-devops-ci-cd/" class="cmd-item" role="option" data-keyword="azure functions devops ci cd cloud serverless vscode">
          <span class="cmd-item-icon">✦</span>
          <span class="cmd-item-label">Deploy Azure Functions with CI/CD</span>
          <span class="cmd-item-badge">Azure</span>
        </a>
      </div>

      <!-- Section: Quick Actions -->
      <div class="cmd-group" data-group="actions">
        <span class="cmd-group-title">Actions</span>
        <button type="button" class="cmd-item" role="option" id="cmd-copy-email" data-keyword="copy email contact address hello" data-email={CONTACT_EMAIL}>
          <span class="cmd-item-icon">📋</span>
          <span class="cmd-item-label">Copy Email Address ({CONTACT_EMAIL})</span>
          <span class="cmd-item-badge" id="cmd-email-badge">Copy</span>
        </button>
        <button type="button" class="cmd-item" role="option" id="cmd-toggle-sound" data-keyword="toggle sound audio effects clicks mute">
          <span class="cmd-item-icon">♫</span>
          <span class="cmd-item-label">Toggle Tactile Sound FX</span>
          <span class="cmd-item-badge" id="cmd-sound-badge">Off</span>
        </button>
        <a href="/Resumes_Usama_12yrs.pdf" download class="cmd-item" role="option" data-keyword="download resume pdf cv">
          <span class="cmd-item-icon">↓</span>
          <span class="cmd-item-label">Download Resume (PDF)</span>
          <span class="cmd-item-badge">PDF</span>
        </a>
      </div>
    </div>

    <div class="cmd-footer">
      <span><kbd>↑</kbd> <kbd>↓</kbd> Navigate</span>
      <span><kbd>↵</kbd> Select</span>
      <span><kbd>ESC</kbd> Close</span>
    </div>
  </div>
</dialog>

<script>
  import { playClickSound, playSuccessSound, toggleSound, isSoundEnabled } from '../scripts/sound';

  const dialog = document.getElementById('command-palette') as HTMLDialogElement | null;
  const input = document.getElementById('cmd-input') as HTMLInputElement | null;
  const items = Array.from(document.querySelectorAll<HTMLElement>('.cmd-item'));
  const soundBadge = document.getElementById('cmd-sound-badge');
  const emailButton = document.getElementById('cmd-copy-email') as HTMLButtonElement | null;
  const emailBadge = document.getElementById('cmd-email-badge');
  const soundButton = document.getElementById('cmd-toggle-sound') as HTMLButtonElement | null;

  function updateSoundBadge() {
    if (soundBadge) {
      soundBadge.textContent = isSoundEnabled() ? 'ON' : 'OFF';
    }
  }

  function openPalette() {
    if (!dialog) return;
    updateSoundBadge();
    dialog.showModal();
    input?.focus();
    if (input) input.value = '';
    filterItems('');
    playClickSound(1.2);
  }

  function closePalette() {
    if (!dialog) return;
    dialog.close();
    playClickSound(0.8);
  }

  function filterItems(query: string) {
    const q = query.toLowerCase().trim();
    let visibleCount = 0;

    items.forEach((item) => {
      const text = (item.textContent || '').toLowerCase();
      const keyword = (item.dataset.keyword || '').toLowerCase();
      const match = !q || text.includes(q) || keyword.includes(q);
      item.hidden = !match;
      if (match) {
        visibleCount++;
        item.classList.remove('selected');
      }
    });

    // Hide empty groups
    document.querySelectorAll<HTMLElement>('.cmd-group').forEach((group) => {
      const hasVisible = Array.from(group.querySelectorAll<HTMLElement>('.cmd-item')).some(i => !i.hidden);
      group.hidden = !hasVisible;
    });

    // Select first visible
    const first = items.find(i => !i.hidden);
    if (first) {
      first.classList.add('selected');
    }
  }

  // Handle global shortcuts
  window.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      if (dialog?.open) {
        closePalette();
      } else {
        openPalette();
      }
    }
  });

  // Open button trigger from Header
  document.querySelectorAll('[data-open-cmd]').forEach((btn) => {
    btn.addEventListener('click', openPalette);
  });

  // Dialog click backdrop to close
  dialog?.addEventListener('click', (e) => {
    if (e.target === dialog) {
      closePalette();
    }
  });

  // Search input filtering
  input?.addEventListener('input', () => {
    filterItems(input.value);
  });

  // Keyboard navigation within list
  dialog?.addEventListener('keydown', (e) => {
    const visible = items.filter(i => !i.hidden);
    const currentIndex = visible.findIndex(i => i.classList.contains('selected'));

    if (e.key === 'ArrowDown') {
      e.preventDefault();
      const nextIndex = (currentIndex + 1) % visible.length;
      visible.forEach(i => i.classList.remove('selected'));
      visible[nextIndex]?.classList.add('selected');
      visible[nextIndex]?.scrollIntoView({ block: 'nearest' });
      playClickSound(1.1);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      const prevIndex = (currentIndex - 1 + visible.length) % visible.length;
      visible.forEach(i => i.classList.remove('selected'));
      visible[prevIndex]?.classList.add('selected');
      visible[prevIndex]?.scrollIntoView({ block: 'nearest' });
      playClickSound(1.1);
    } else if (e.key === 'Enter') {
      const selected = visible[currentIndex];
      if (selected) {
        e.preventDefault();
        selected.click();
      }
    }
  });

  // Actions
  emailButton?.addEventListener('click', async () => {
    const email = emailButton.dataset.email;
    if (email) {
      try {
        await navigator.clipboard.writeText(email);
        if (emailBadge) emailBadge.textContent = 'Copied!';
        playSuccessSound();
        setTimeout(() => {
          if (emailBadge) emailBadge.textContent = 'Copy';
          closePalette();
        }, 800);
      } catch {
        closePalette();
      }
    }
  });

  soundButton?.addEventListener('click', () => {
    toggleSound();
    updateSoundBadge();
  });

  // Sound sync listener
  window.addEventListener('sound-toggle', updateSoundBadge);
  updateSoundBadge();
</script>

<style>
  .cmd-dialog {
    border: none;
    border-radius: 12px;
    padding: 0;
    background: transparent;
    max-width: 580px;
    width: calc(100% - 2rem);
    box-shadow: 0 25px 50px -12px rgba(15, 20, 32, 0.35);
    margin: auto;
    overflow: hidden;
  }

  .cmd-dialog::backdrop {
    background: rgba(15, 20, 32, 0.45);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }

  .cmd-box {
    background: var(--surface-card);
    border: 1px solid rgb(var(--gray-light));
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .cmd-search-wrap {
    display: flex;
    align-items: center;
    padding: 0.9rem 1.1rem;
    gap: 0.75rem;
    border-bottom: 1px solid rgb(var(--gray-light));
    background: var(--surface-card);
  }

  .cmd-icon {
    color: rgb(var(--gray));
    flex-shrink: 0;
  }

  .cmd-input {
    border: none;
    background: transparent;
    padding: 0;
    font-size: 1rem;
    font-family: var(--font-ui);
    color: rgb(var(--black));
    width: 100%;
    outline: none;
    box-shadow: none !important;
  }

  .cmd-esc-hint {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    padding: 0.15rem 0.4rem;
    background: var(--surface-alt);
    border: 1px solid rgb(var(--gray-light));
    border-radius: 4px;
    color: rgb(var(--gray));
    flex-shrink: 0;
  }

  .cmd-results {
    max-height: 380px;
    overflow-y: auto;
    padding: 0.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cmd-group {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .cmd-group-title {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: rgb(var(--gray));
    padding: 0.4rem 0.6rem 0.2rem;
  }

  .cmd-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 6px;
    text-decoration: none;
    color: rgb(var(--black));
    font-size: 0.9rem;
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    cursor: pointer;
    font-family: var(--font-ui);
    transition: background-color 140ms ease, transform 140ms ease;
  }

  .cmd-item:hover,
  .cmd-item.selected {
    background: var(--accent-soft);
    color: var(--accent-dark);
  }

  .cmd-item-icon {
    font-size: 1rem;
    color: var(--ink-blue);
    flex-shrink: 0;
    width: 20px;
    text-align: center;
  }

  .cmd-item-label {
    flex: 1;
    font-weight: 500;
  }

  .cmd-item-badge {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.15rem 0.45rem;
    background: var(--surface-alt);
    border: 1px solid rgb(var(--gray-light));
    border-radius: 4px;
    color: rgb(var(--gray-dark));
  }

  .cmd-footer {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 0.6rem 1.1rem;
    border-top: 1px solid rgb(var(--gray-light));
    background: var(--surface-alt);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: rgb(var(--gray));
  }

  .cmd-footer kbd {
    background: var(--surface-card);
    border: 1px solid rgb(var(--gray-light));
    border-radius: 3px;
    padding: 0.1rem 0.3rem;
  }

  @media (max-width: 600px) {
    .cmd-footer {
      display: none;
    }
  }
</style>
