---
import { getCollection } from 'astro:content';
import { CONTACT_EMAIL } from '../consts';
const pages = [
  ['/', 'Home', 'index'], ['/#projects', 'Personal projects', 'open source localfinance apporigins'],
  ['/work', 'Case studies', 'work azure ai agents localfinance architecture'], ['/blog', 'Blog', 'writing articles'], ['/uses', 'Uses', 'setup hardware tools'],
  ['/about', 'About', 'career microsoft'], ['/r', 'Resume', 'cv pdf'], ['/contact', 'Contact', 'email connect'],
];
const posts = await getCollection('blog');
---
<dialog id="command-palette" aria-label="Quick search">
  <div class="cmd-head"><label for="cmd-input" class="sr-only">Search pages, articles, and actions</label><input id="cmd-input" type="search" placeholder="Where would you like to go?" autocomplete="off" role="combobox" aria-expanded="true" aria-controls="cmd-results" aria-autocomplete="list" /><button type="button" class="cmd-close" aria-label="Close search">Esc</button></div>
  <div class="cmd-results" id="cmd-results" role="listbox" aria-label="Search results">
    <div class="cmd-group" role="group" aria-label="Pages"><span class="cmd-group-title" aria-hidden="true">Explore</span>{pages.map(([href, name, keywords], i) => <a id={`cmd-page-${i}`} class="cmd-item" role="option" aria-selected="false" href={href} data-keyword={keywords}><span>{name}</span><span class="cmd-item-meta" aria-hidden="true">↗</span></a>)}</div>
    <div class="cmd-group" role="group" aria-label="Articles"><span class="cmd-group-title" aria-hidden="true">Writing</span>{posts.map((post, i) => <a id={`cmd-post-${i}`} class="cmd-item" role="option" aria-selected="false" href={`/blog/${post.id}/`} data-keyword={post.data.description}><span>{post.data.title}</span><span class="cmd-item-meta" aria-hidden="true">↗</span></a>)}</div>
    <div class="cmd-group" role="group" aria-label="Actions"><span class="cmd-group-title" aria-hidden="true">Quick actions</span>
      <button type="button" id="cmd-copy-email" class="cmd-item" role="option" aria-selected="false" data-keyword="copy email contact" data-email={CONTACT_EMAIL}><span>Copy email address</span><span id="cmd-email-badge" class="cmd-item-meta">Copy</span></button>
      <button type="button" id="cmd-toggle-sound" class="cmd-item" role="option" aria-selected="false" data-keyword="sound audio effects mute"><span>Sound effects</span><span id="cmd-sound-badge" class="cmd-item-meta">Off</span></button>
      <a href="/Resumes_Usama_12yrs.pdf" download id="cmd-resume" class="cmd-item" role="option" aria-selected="false" data-keyword="download resume cv pdf"><span>Download résumé</span><span class="cmd-item-meta">PDF</span></a>
    </div>
  </div>
  <p class="cmd-empty" hidden>No matches. Try “blog”, “setup”, or “email”.</p>
  <div class="cmd-footer"><span>↑ ↓ to navigate · Enter to open</span><span class="cmd-status" role="status" aria-live="polite"></span></div>
</dialog>
<script>
  import { toggleSound, isSoundEnabled, playClickSound, playSuccessSound } from '../scripts/sound';
  const dialog = document.querySelector<HTMLDialogElement>('#command-palette')!;
  const input = dialog.querySelector<HTMLInputElement>('#cmd-input')!;
  const items = Array.from(dialog.querySelectorAll<HTMLElement>('.cmd-item'));
  const status = dialog.querySelector<HTMLElement>('.cmd-status')!;
  let returnFocus: HTMLElement | null = null;
  function select(item?: HTMLElement) {
    items.forEach(el => el.setAttribute('aria-selected', String(el === item)));
    if (item) input.setAttribute('aria-activedescendant', item.id);
    else input.removeAttribute('aria-activedescendant');
  }
  function filter() {
    const q = input.value.trim().toLowerCase();
    items.forEach(item => { item.hidden = !`${item.textContent} ${item.dataset.keyword}`.toLowerCase().includes(q); });
    dialog.querySelectorAll<HTMLElement>('.cmd-group').forEach(group => { group.hidden = !Array.from(group.querySelectorAll<HTMLElement>('.cmd-item')).some(item => !item.hidden); });
    const visible = items.filter(item => !item.hidden);
    dialog.querySelector<HTMLElement>('.cmd-empty')!.hidden = visible.length > 0;
    select(visible[0]);
    status.textContent = `${visible.length} results`;
  }
  function open() { if (dialog.open) return; returnFocus = document.activeElement as HTMLElement; input.value = ''; dialog.showModal(); filter(); input.focus(); playClickSound(); }
  function close() { dialog.close(); }
  document.querySelectorAll('[data-open-cmd]').forEach(button => button.addEventListener('click', open));
  dialog.querySelector('.cmd-close')?.addEventListener('click', close);
  dialog.addEventListener('close', () => returnFocus?.focus());
  dialog.addEventListener('click', event => { if (event.target === dialog) { const rect = dialog.getBoundingClientRect(); if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) close(); } });
  input.addEventListener('input', filter);
  document.addEventListener('keydown', event => { if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') { event.preventDefault(); dialog.open ? close() : open(); } });
  input.addEventListener('keydown', event => {
    const visible = items.filter(item => !item.hidden);
    const index = visible.findIndex(item => item.getAttribute('aria-selected') === 'true');
    if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
      event.preventDefault(); if (!visible.length) return;
      const next = visible[(index + (event.key === 'ArrowDown' ? 1 : -1) + visible.length) % visible.length];
      select(next); next.scrollIntoView({ block: 'nearest' });
    } else if (event.key === 'Enter' && index >= 0) { event.preventDefault(); visible[index].click(); }
  });
  dialog.querySelectorAll('a.cmd-item').forEach(link => link.addEventListener('click', close));
  const soundBadge = dialog.querySelector('#cmd-sound-badge')!;
  const updateSound = () => { soundBadge.textContent = isSoundEnabled() ? 'On' : 'Off'; };
  dialog.querySelector('#cmd-toggle-sound')?.addEventListener('click', () => { toggleSound(); updateSound(); });
  window.addEventListener('sound-toggle', updateSound); updateSound();
  const emailButton = dialog.querySelector<HTMLButtonElement>('#cmd-copy-email')!;
  emailButton.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(emailButton.dataset.email!); dialog.querySelector('#cmd-email-badge')!.textContent = 'Copied'; status.textContent = 'Email address copied'; playSuccessSound(); }
    catch { status.textContent = `Email: ${emailButton.dataset.email}`; }
  });
</script>
<style>
  dialog { width: min(620px, calc(100% - 32px)); max-height: 80dvh; padding: 0; border: 1px solid var(--border); border-radius: 16px; background: var(--surface-card); color: var(--text); box-shadow: 0 32px 100px #11182730; }
  dialog[open] { animation: enter 260ms var(--ease-out); }
  dialog::backdrop { background: #11182770; backdrop-filter: blur(6px); }
  .cmd-head { display: flex; align-items: center; padding: 1.25rem; gap: 1rem; border-bottom: 1px solid var(--border); }
  input { width: 100%; min-width: 0; border: 0; background: transparent; color: var(--text); font-size: 1rem; min-height: 44px; }
  input::placeholder { color: var(--text-muted); }
  input:focus-visible { outline-offset: 2px; }
  .cmd-close { background: var(--surface-alt); border: 1px solid var(--border); border-radius: 8px; font-size: .7rem; min-height: 44px; min-width: 44px; }
  .cmd-results { max-height: 52dvh; overflow-y: auto; overscroll-behavior: contain; padding: .75rem; }
  .cmd-group-title { display: block; padding: .85rem .75rem .4rem; color: var(--text-muted); font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; }
  .cmd-item { display: flex; align-items: center; justify-content: space-between; width: 100%; gap: 1rem; text-align: left; border: 0; border-radius: 8px; background: transparent; padding: .75rem; font-size: .86rem; }
  .cmd-item[aria-selected='true'], .cmd-item:hover { background: var(--accent-soft); color: var(--accent); }
  .cmd-item-meta { flex-shrink: 0; color: var(--text-muted); font-size: .75rem; }
  .cmd-footer { padding: 1rem 1.5rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: .5rem; border-top: 1px solid var(--border); font-size: .7rem; color: var(--text-muted); }
  .cmd-empty { padding: 2rem; font-size: .9rem; color: var(--text-body); }
</style>
