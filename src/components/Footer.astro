---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-container">
		<div class="footer-left">
			<p class="copyright">&copy; {year} Usama Ansari. Built with Astro & TypeScript.</p>
			<p class="footer-motto">Distributed systems • AI agent platforms • High-availability telemetry.</p>
		</div>

		<div class="footer-center">
			<button type="button" class="footer-cmd-hint" data-open-cmd>
				<span>Quick Switcher</span>
				<kbd>⌘K</kbd>
			</button>
		</div>

		<div class="footer-right">
			<div class="footer-links">
				<a href="https://www.linkedin.com/in/usamaansari/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
				<a href="https://github.com/usmslm102" target="_blank" rel="noreferrer">GitHub ↗</a>
				<a href="https://x.com/usmslm102" target="_blank" rel="noreferrer">X ↗</a>
				<a href="/rss.xml" target="_blank" rel="noreferrer">RSS ↗</a>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		padding: 3rem 1.25rem;
		background: var(--surface-card);
		border-top: 1px solid rgb(var(--gray-light));
		font-family: var(--font-ui);
		margin-top: auto;
	}

	.footer-container {
		max-width: 1100px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.footer-left {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
	}

	.copyright {
		margin: 0;
		font-size: 0.88rem;
		font-weight: 600;
		color: rgb(var(--black));
	}

	.footer-motto {
		margin: 0;
		font-size: 0.78rem;
		color: rgb(var(--gray));
		font-family: var(--font-mono);
	}

	.footer-center {
		display: flex;
		align-items: center;
	}

	.footer-cmd-hint {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0.65rem;
		background: var(--surface-alt);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: rgb(var(--gray-dark));
		cursor: pointer;
		transition: all 140ms ease;
	}

	.footer-cmd-hint:hover {
		border-color: var(--accent);
		color: var(--accent-dark);
		background: var(--accent-soft);
	}

	.footer-cmd-hint kbd {
		background: var(--surface-card);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 3px;
		padding: 0.08rem 0.3rem;
		font-size: 0.65rem;
	}

	.footer-right {
		display: flex;
		align-items: center;
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 0.85rem;
		flex-wrap: wrap;
	}

	.footer-links a {
		font-family: var(--font-mono);
		font-size: 0.76rem;
		font-weight: 600;
		color: var(--ink-blue);
		text-decoration: none;
		transition: color 140ms ease;
	}

	.footer-links a:hover {
		color: var(--accent-dark);
		background: transparent;
	}

	@media (max-width: 760px) {
		.footer-container {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.25rem;
		}

		.footer-center {
			order: 3;
		}
	}
</style>
