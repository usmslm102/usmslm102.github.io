---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-container">
		<div class="footer-left">
			<p class="copyright">&copy; {year} Usama Ansari. Built with Astro & TypeScript.</p>
			<p class="footer-motto">Distributed systems • AI agent platforms • High-availability telemetry.</p>
		</div>

		<div class="footer-center">
			<button type="button" class="footer-cmd-hint" data-open-cmd>
				<span>Quick Switcher</span>
				<kbd>⌘K</kbd>
			</button>
		</div>

		<div class="footer-right">
			<div class="footer-links">
				<a href="https://www.linkedin.com/in/usamaansari/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
				<a href="https://github.com/usmslm102" target="_blank" rel="noreferrer">GitHub ↗</a>
				<a href="https://x.com/usmslm102" target="_blank" rel="noreferrer">X ↗</a>
				<a href="/rss.xml" target="_blank" rel="noreferrer">RSS ↗</a>
			</div>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		padding: 3.5rem 1.5rem;
		background: var(--surface);
		border-top: 1px solid var(--border);
		font-family: var(--font-ui);
		margin-top: auto;
	}

	.footer-container {
		max-width: 1060px;
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.footer-left {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
	}

	.copyright {
		margin: 0;
		font-size: 0.86rem;
		font-weight: 500;
		color: #111111;
	}

	.footer-motto {
		margin: 0;
		font-size: 0.76rem;
		color: var(--text-muted);
		font-family: var(--font-mono);
	}

	.footer-center {
		display: flex;
		align-items: center;
	}

	.footer-cmd-hint {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.35rem 0.6rem;
		background: var(--surface-card);
		border: 1px solid var(--border);
		border-radius: 4px;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-muted);
		cursor: pointer;
		transition: transform 140ms var(--ease-out), border-color 140ms var(--ease-out), color 140ms var(--ease-out);
	}

	.footer-cmd-hint:active {
		transform: scale(0.98);
	}

	@media (hover: hover) and (pointer: fine) {
		.footer-cmd-hint:hover {
			border-color: #111111;
			color: #111111;
		}
	}

	.footer-cmd-hint kbd {
		background: var(--surface-alt);
		border: 1px solid var(--border);
		border-radius: 3px;
		padding: 0.08rem 0.3rem;
		font-size: 0.65rem;
		color: #111111;
	}

	.footer-right {
		display: flex;
		align-items: center;
	}

	.footer-links {
		display: flex;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.footer-links a {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 500;
		color: var(--text-muted);
		text-decoration: none;
		transition: color 140ms var(--ease-out);
	}

	@media (hover: hover) and (pointer: fine) {
		.footer-links a:hover {
			color: #111111;
			text-decoration: underline;
			text-decoration-thickness: 1px;
			text-underline-offset: 3px;
		}
	}

	@media (max-width: 760px) {
		.footer-container {
			flex-direction: column;
			align-items: flex-start;
			gap: 1.25rem;
		}

		.footer-center {
			order: 3;
		}
	}
</style>
