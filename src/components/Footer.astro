---
import { CONTACT_EMAIL } from '../consts';
const isContact = Astro.url.pathname.replace(/\/$/, '') === '/contact';
---
<footer class="site-footer">
  <div class="container">
    {!isContact && <div class="footer-invitation" data-reveal>
      <p>Have something interesting in mind?</p>
      <a href="/contact" class="footer-hello">Let’s talk.<span aria-hidden="true">↗</span></a>
    </div>}
    <div class="footer-bottom">
      <div class="footer-signature"><a href="/">Usama Ansari<span class="accent">*</span></a><p>Thoughtfully built. Always evolving.</p></div>
      <div class="footer-socials">
        <a href="https://github.com/usmslm102" target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href="https://www.linkedin.com/in/usamaansari/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
        <a href="https://x.com/usmslm102" target="_blank" rel="noreferrer">X ↗</a>
        <a href="/rss.xml">RSS ↗</a>
      </div>
      <div class="footer-meta"><span>© {new Date().getFullYear()}</span><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></div>
    </div>
  </div>
</footer>
<style>
  .site-footer { margin-top: var(--space-section); border-top: 1px solid var(--border); }
  .footer-invitation { padding-block: clamp(3rem, 7vw, 6rem); }
  .footer-invitation p { color: var(--text-body); font-size: 1rem; }
  .footer-hello { display: flex; justify-content: space-between; align-items: center; font-family: var(--font-display); font-size: clamp(4.5rem, 13vw, 12rem); font-weight: 600; letter-spacing: -.065em; line-height: 1.2; }
  .footer-hello span { color: var(--accent); font-weight: 400; transition: transform 500ms var(--ease-out); }
  .footer-hello:hover span { transform: translate(8px, -8px); }
  .footer-bottom { border-top: 1px solid var(--border); display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 2rem; padding-block: 2.5rem; font-size: .78rem; }
  .footer-signature > a { font-family: var(--font-display); font-size: 1.15rem; font-weight: 600; letter-spacing: -.03em; }
  .footer-signature .accent { margin-left: .2rem; font-size: .65rem; vertical-align: top; }
  .footer-signature p { color: var(--text-muted); margin-top: .3rem; }
  .footer-socials { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  .footer-socials a { padding-block: .75rem; }
  .footer-meta { justify-self: end; text-align: right; color: var(--text-muted); display: grid; gap: .25rem; }
  a:hover { color: var(--accent); }
  @media (max-width: 900px) { .footer-bottom { grid-template-columns: 1fr 1fr; } .footer-meta { grid-column: 1 / -1; justify-self: start; text-align: left; display: flex; gap: 1rem; } .footer-socials { justify-content: end; } }
  @media (max-width: 640px) { .footer-bottom { grid-template-columns: 1fr; gap: 1.5rem; } .footer-socials { justify-content: start; } .footer-hello { font-size: 19vw; } }
</style>
