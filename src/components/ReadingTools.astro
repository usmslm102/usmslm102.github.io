<div class="reading-progress" aria-hidden="true"></div>
<div class="reading-tools" hidden>
  <span class="reading-time"></span>
  <details class="toc-accordion"><summary>On this page</summary><nav class="toc-nav" aria-label="Article sections"></nav></details>
  <button type="button" class="copy-link">Copy article link ↗</button><span class="copy-status status" role="status" aria-live="polite"></span>
</div>
<script>
  import { playSuccessSound } from '../scripts/sound';
  const prose = document.querySelector<HTMLElement>('.prose');
  const tools = document.querySelector<HTMLElement>('.reading-tools');
  if (prose && tools) {
    tools.hidden = false;
    const count = (prose.textContent || '').trim().split(/\s+/).length;
    tools.querySelector('.reading-time')!.textContent = `${Math.max(1, Math.ceil(count / 220))} min read`;
    const headings = prose.querySelectorAll<HTMLHeadingElement>('h2,h3,h4,h5,h6');
    const nav = tools.querySelector('nav')!;
    headings.forEach((heading, index) => {
      if (!heading.id) heading.id = `section-${index}`;
      const link = document.createElement('a'); link.href = `#${heading.id}`; link.textContent = heading.textContent;
      if (Number(heading.tagName[1]) >= 3) link.className = 'toc-nested';
      nav.append(link);
    });
    const details = tools.querySelector('details')!;
    if (!headings.length) details.hidden = true;
    else details.open = matchMedia('(min-width: 769px)').matches;
    tools.querySelector('.copy-link')?.addEventListener('click', async () => {
      const status = tools.querySelector('.copy-status')!;
      try { await navigator.clipboard.writeText(location.href); status.textContent = 'Link copied'; playSuccessSound(); }
      catch { status.textContent = 'Copy the URL from your address bar.'; }
    });
    prose.querySelectorAll('pre').forEach(pre => {
      const button = document.createElement('button'); button.type = 'button'; button.className = 'copy-code'; button.textContent = 'Copy code'; button.setAttribute('aria-label', 'Copy code snippet to clipboard');
      button.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(pre.querySelector('code')?.textContent || pre.textContent || ''); button.textContent = 'Copied!'; playSuccessSound(); setTimeout(() => button.textContent = 'Copy code', 2000); }
        catch { button.textContent = 'Select code to copy'; }
      });
      pre.before(button);
    });
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        nav.querySelectorAll('a').forEach(link => {
          if (link.hash === `#${entry.target.id}`) link.setAttribute('aria-current', 'location');
          else link.removeAttribute('aria-current');
        });
      });
    }, { rootMargin: '-100px 0px -65% 0px' });
    headings.forEach(heading => observer.observe(heading));
    window.addEventListener('pagehide', () => observer.disconnect(), { once: true });
  }
</script>
<style>
  .reading-progress { position: fixed; top: 0; left: 0; right: 0; height: 2px; background: var(--accent); z-index: calc(var(--layer-header) + 1); transform: scaleX(0); transform-origin: left; }
  @supports (animation-timeline: scroll()) { .reading-progress { animation: progress linear both; animation-timeline: scroll(root); } @keyframes progress { to { transform: scaleX(1); } } }
  .reading-time { display: block; font-size: .75rem; color: var(--accent); margin-bottom: 1.5rem; }
  .toc-accordion summary { font-size: .85rem; font-weight: 500; padding-block: .5rem; }
  .toc-nav { display: grid; padding-block: .75rem; }
  .toc-nav :global(a) { padding-block: .5rem; font-size: .78rem; color: var(--text-muted); line-height: 1.5; }
  .toc-nav :global(a.toc-nested) { padding-left: .75rem; font-size: .72rem; }
  .toc-nav :global(a:hover), .toc-nav :global(a[aria-current]) { color: var(--accent); }
  .copy-link { display: block; background: transparent; border: 1px solid var(--border); border-radius: 100px; padding: .65rem 1rem; min-height: 44px; font-size: .75rem; margin-block: 1.5rem .5rem; }
  .copy-link:hover { border-color: var(--accent); color: var(--accent); }
  .copy-status { display: block; font-size: .7rem; }
</style>
<style is:global>
  .copy-code { display: block; margin: 1.5rem 0 .5rem auto; min-height: 44px; padding: .5rem .9rem; border: 1px solid var(--border); border-radius: 100px; background: var(--surface-card); color: var(--text-body); font-size: .75rem; }
  .copy-code:hover { color: var(--accent); border-color: var(--accent); }
  .copy-code + pre { margin-top: .5rem; }
</style>
