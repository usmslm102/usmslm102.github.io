---
import { ArrowUpRight } from '@lucide/astro';
import { Image } from 'astro:assets';
import localFinance from '../assets/projects/local-finance.png';
import appOrigins from '../assets/projects/app-origins.png';
import tunnelbar from '../assets/projects/tunnelbar.png';

const projects = [
  {
    name: 'LocalFinance',
    category: 'Personal finance',
    headline: 'Your money. Your machine.',
    description: 'Turn Indian bank and credit card statements into a clear picture of your spending. Import, categorize, and explore your finances with your data stored locally in SQLite.',
    context: 'Built around a practical need: understand spending without handing financial data to a hosted service.',
    features: ['Offline finance analysis', 'Bank statement imports', 'Go · React · SQLite'],
    image: localFinance,
    alt: 'LocalFinance transactions ledger with spending summaries, account filters, and categorized bank transactions.',
    site: 'https://usamaansari.com/local-finance/',
    repo: 'https://github.com/usmslm102/local-finance',
    tone: 'finance',
  },
  {
    name: 'AppOrigins',
    category: 'macOS utility',
    headline: 'Know what’s on your Mac.',
    description: 'A native macOS utility that traces installed apps and CLI tools back to their source. See versions, disk usage, signing status, and duplicate installs in one place.',
    context: 'A single view for a Mac setup that can otherwise be scattered across several installation sources.',
    features: ['Homebrew · App Store · Manual', 'Duplicate & signing checks', 'Swift · SwiftUI'],
    image: appOrigins,
    alt: 'AppOrigins showing installed Mac apps and CLI tools, their installation sources, signing status, sizes, and app details.',
    site: 'https://usamaansari.com/mac-app-origins/',
    repo: 'https://github.com/usmslm102/mac-app-origins',
    tone: 'origins',
  },
  {
    name: 'TunnelBar',
    category: 'Developer tool',
    headline: 'Localhost, a little further.',
    description: 'Share a local service through an email-protected link from your Mac’s menu bar. Create temporary Cloudflare tunnels without an account, reuse recent shares, and stop sharing when you’re done.',
    context: 'A focused menu bar workflow for sharing a local service while keeping access email-protected.',
    features: ['Email-protected links', 'No account needed', 'Swift · SwiftUI · AppKit'],
    image: tunnelbar,
    alt: 'TunnelBar macOS menu bar app showing a local port, email protection, a Create protected link button, and recent shares.',
    site: 'https://usamaansari.com/tunnelbar/',
    repo: 'https://github.com/usmslm102/tunnelbar',
    tone: 'tunnelbar',
  },
];
---
<section class="projects-section section-space" id="projects" aria-labelledby="projects-title">
  <div class="section-head" data-reveal>
    <div><span class="eyebrow">Built out of curiosity</span><h2 id="projects-title">Small ideas.<br />Useful things.</h2></div>
    <a href="https://github.com/usmslm102" target="_blank" rel="noreferrer" class="text-link">More on GitHub <ArrowUpRight class="icon arrow" aria-hidden="true" /></a>
  </div>
  <div class="project-list">
    {projects.map((project) => <article class={`project project-${project.tone}`} data-reveal aria-labelledby={`project-${project.tone}`}>
      <a class="project-preview" href={project.site} target="_blank" rel="noreferrer" aria-label={`Visit ${project.name} (opens in a new tab)`}>
        <Image src={project.image} alt={project.alt} widths={[400, 640, 800, 1200]} sizes="(max-width: 640px) calc(100vw - 88px), (max-width: 768px) calc(100vw - 112px), (max-width: 1400px) 40vw, 620px" format="webp" quality={85} loading="lazy" />
      </a>
      <div class="project-meta"><span>{project.category}</span><span>Open source</span></div>
      <div class="project-title"><h3 id={`project-${project.tone}`}>{project.name}</h3><a class="project-visit" href={project.site} target="_blank" rel="noreferrer" aria-label={`Visit ${project.name}`}><ArrowUpRight class="icon arrow" aria-hidden="true" /></a></div>
      <p class="project-headline">{project.headline}</p>
      <p class="project-description">{project.description}</p>
      <p class="project-context">{project.context}</p>
      {project.tone === 'finance' && <a class="text-link project-story" href="/work/#localfinance">Explore the case study <ArrowUpRight class="icon arrow" aria-hidden="true" /></a>}
      <div class="project-bottom"><span>{project.features[2]}</span><a href={project.repo} target="_blank" rel="noreferrer">View source <ArrowUpRight class="icon arrow" aria-hidden="true" /></a></div>
    </article>)}
  </div>
</section>
<style>
  .projects-section { padding-bottom: 0; }
  .project-list { display: grid; grid-template-columns: 1.15fr 1fr; align-items: start; gap: clamp(2rem, 5vw, 5rem); }
  .project-origins { margin-top: 9rem; }
  .project-preview { display: flex; align-items: center; justify-content: center; aspect-ratio: 1.22; background: var(--accent-soft); border-radius: var(--radius); padding: 2rem; overflow: hidden; }
  .project-origins .project-preview { background: var(--surface-sunken); aspect-ratio: 1.1; }
  .project-tunnelbar .project-preview { background: var(--surface-sunken); }
  .project-tunnelbar .project-preview img { width: auto; height: 100%; max-width: 100%; object-fit: contain; }
  .project-preview img { width: 100%; border-radius: 6px; box-shadow: 0 18px 38px #15204420; transition: transform 650ms var(--ease-out); }
  .project-preview:hover img { transform: scale(1.04) rotate(-1deg); }
  .project-meta { display: flex; justify-content: space-between; gap: 1rem; margin-top: 1.5rem; font-size: .72rem; color: var(--text-muted); }
  .project-title { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-top: .65rem; }
  .project-title h3 { font-size: clamp(2rem, 3.5vw, 3rem); }
  .project-visit { display: grid; place-items: center; width: 44px; height: 44px; font-size: 1.75rem; color: var(--accent); }
  .project-headline { font-size: 1rem; margin-top: .5rem; }
  .project-description { margin-top: .75rem; font-size: .92rem; color: var(--text-body); max-width: 54ch; }
  .project-context { margin-top: .75rem; font-size: .9rem; color: var(--text-body); max-width: 54ch; }
  .project-story { margin-top: .6rem; }
  .project-bottom { display: flex; justify-content: space-between; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border); font-size: .72rem; color: var(--text-muted); }
  .project-bottom a { min-height: 44px; display: inline-flex; align-items: center; color: var(--text); }
  .project-bottom a:hover { color: var(--accent); }
  @media (max-width: 768px) { .project-list { grid-template-columns: 1fr; gap: 3.5rem; } .project-origins { margin-top: 0; } .project-preview, .project-origins .project-preview { aspect-ratio: 1.25; padding: 1.5rem; } }
</style>
