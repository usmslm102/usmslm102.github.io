---
// Interactive Studio Workbench Component
---

<section class="workbench" aria-label="Interactive workbench tour">
  <!-- Workbench Instrument Header -->
  <div class="desk-topline">
    <div class="topline-left">
      <span class="pulsing-dot" aria-hidden="true"></span>
      <span class="topline-title">THE ENGINEERING WORKBENCH</span>
    </div>
    <span class="topline-hint">CLICK AN INSTRUMENT DOCK TO INSPECT ↓</span>
  </div>

  <!-- Interactive Station Dock (satisfies smoke test [data-detail="..."] and aria-pressed) -->
  <div class="station-dock" role="tablist" aria-label="Workbench stations">
    <button
      type="button"
      class="desk-object station-tab active"
      data-detail="editor"
      aria-label="Explore editor and terminal setup"
      aria-pressed="true"
    >
      <span class="tab-index">01</span>
      <div class="tab-info">
        <span class="tab-name">Editor & Terminal</span>
        <span class="tab-sub">Ghostty + VS Code + Copilot</span>
      </div>
    </button>

    <button
      type="button"
      class="desk-object station-tab"
      data-detail="hardware"
      aria-label="Explore Mac Mini M4 hardware setup"
      aria-pressed="false"
    >
      <span class="tab-index">02</span>
      <div class="tab-info">
        <span class="tab-name">Hardware Engine</span>
        <span class="tab-sub">Mac Mini M4 + Display + AirPods</span>
      </div>
    </button>

    <button
      type="button"
      class="desk-object station-tab"
      data-detail="stack"
      aria-label="Explore engineering stack"
      aria-pressed="false"
    >
      <span class="tab-index">03</span>
      <div class="tab-info">
        <span class="tab-name">Engineering Stack</span>
        <span class="tab-sub">TypeScript + .NET + Azure</span>
      </div>
    </button>

    <button
      type="button"
      class="desk-object station-tab"
      data-detail="apps"
      aria-label="Explore daily apps and productivity shortcuts"
      aria-pressed="false"
    >
      <span class="tab-index">04</span>
      <div class="tab-info">
        <span class="tab-name">Daily Apps</span>
        <span class="tab-sub">Raycast + Chrome + ChatGPT</span>
      </div>
    </button>
  </div>

  <!-- Interactive Station Display Window -->
  <div class="workbench-display">
    <!-- View 1: Editor & Ghostty Terminal -->
    <div class="station-view view-editor" data-view="editor">
      <div class="terminal-window">
        <div class="terminal-bar">
          <div class="term-dots"><i></i><i></i><i></i></div>
          <div class="term-tabs">
            <span class="term-tab active">ghostty — zsh</span>
            <span class="term-tab">copilot-cli</span>
            <span class="term-tab">ghostty.config</span>
          </div>
          <span class="term-tag">M4 // GPU ACCELERATED</span>
        </div>

        <div class="terminal-body" id="term-output">
          <p class="term-line"><span class="t-green">usama@mini-m4</span>:<span class="t-blue">~/workspace</span>$ fastfetch</p>
          <div class="fastfetch-box">
            <span class="ff-logo">
              &nbsp;___&nbsp;&nbsp;__&nbsp;&nbsp;<br />
              |&nbsp;&nbsp;\/&nbsp;&nbsp;|&nbsp;<br />
              |&nbsp;|\/|&nbsp;|&nbsp;<br />
              |_|&nbsp;&nbsp;|_|&nbsp;<br />
            </span>
            <div class="ff-info">
              <span class="ff-row"><b class="t-cyan">OS:</b> macOS Sequoia 15.3 (arm64)</span>
              <span class="ff-row"><b class="t-cyan">Host:</b> Mac mini (M4, 2024)</span>
              <span class="ff-row"><b class="t-cyan">Uptime:</b> 12+ years in cloud engineering</span>
              <span class="ff-row"><b class="t-cyan">Shell:</b> zsh 5.9 + starship</span>
              <span class="ff-row"><b class="t-cyan">Terminal:</b> Ghostty (native Metal GPU)</span>
              <span class="ff-row"><b class="t-cyan">Editor:</b> VS Code + Copilot</span>
            </div>
          </div>
          <p class="term-line prompt-line"><span class="t-green">usama@mini-m4</span>:<span class="t-blue">~/workspace</span>$&nbsp;<span class="cursor">▍</span></p>
        </div>

        <div class="terminal-quick-actions">
          <span class="t-action-label">Quick Commands:</span>
          <button type="button" class="term-cmd-btn" data-cmd="fastfetch">fastfetch</button>
          <button type="button" class="term-cmd-btn" data-cmd="status">status</button>
          <button type="button" class="term-cmd-btn" data-cmd="cat stack.json">cat stack.json</button>
          <button type="button" class="term-cmd-btn" data-cmd="clear">clear</button>
        </div>
      </div>
    </div>

    <!-- View 2: Hardware Engine -->
    <div class="station-view view-hardware" data-view="hardware" hidden>
      <div class="hardware-grid">
        <div class="hw-card primary-hw">
          <div class="hw-badge">ANCHOR ENGINE</div>
          <div class="hw-visual">
            <div class="m4-chip-icon">
              <span>M4</span>
            </div>
          </div>
          <h3 class="hw-title">Mac Mini M4</h3>
          <p class="hw-spec">10-core CPU (4 performance + 6 efficiency) • 16-core Neural Engine • 120GB/s unified memory bandwidth</p>
          <div class="hw-tags">
            <span>Apple Silicon</span>
            <span>Silent Thermal</span>
            <span>Thunderbolt 4</span>
          </div>
        </div>

        <div class="hw-card">
          <div class="hw-badge">VISUALS</div>
          <div class="hw-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h3 class="hw-title">External Display</h3>
          <p class="hw-spec">High-density workspace layout: IDE and Ghostty on primary pane, architecture specs and Azure telemetry side-by-side.</p>
          <div class="hw-tags">
            <span>Dual-Pane Focus</span>
            <span>Zero Eye Strain</span>
          </div>
        </div>

        <div class="hw-card">
          <div class="hw-badge">ACOUSTICS</div>
          <div class="hw-icon-wrap">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 18v-6a9 9 0 0 1 18 0v6"></path>
              <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"></path>
            </svg>
          </div>
          <h3 class="hw-title">AirPods Pro 2</h3>
          <p class="hw-spec">Active Noise Cancellation (ANC) with USB-C. Essential for entering uninterrupted deep-flow engineering sessions.</p>
          <div class="hw-tags">
            <span>Spatial Audio</span>
            <span>Flow State</span>
          </div>
        </div>
      </div>
    </div>

    <!-- View 3: Engineering Stack -->
    <div class="station-view view-stack" data-view="stack" hidden>
      <div class="stack-layers">
        <div class="stack-layer">
          <span class="layer-num">LAYER 01 // INTELLIGENCE & AGENTS</span>
          <div class="layer-content">
            <h4>AI Agent Platform & Model Context Protocol (MCP)</h4>
            <p>Multi-model orchestration (GPT-5.2 & GPT-mini), memory persistence, dynamic evaluation pipelines, and Azure AI Foundry.</p>
            <div class="stack-chips">
              <span>MCP Protocol</span>
              <span>Vector Memory</span>
              <span>Cosmos DB</span>
              <span>Azure AI</span>
            </div>
          </div>
        </div>

        <div class="stack-layer">
          <span class="layer-num">LAYER 02 // CLOUD & INFRASTRUCTURE</span>
          <div class="layer-content">
            <h4>Microsoft Azure & Container Mesh</h4>
            <p>Device Health API platform serving 150M req/day at 99.999% SLA across 3M+ monitored Azure nodes. Event-driven Azure Container Apps.</p>
            <div class="stack-chips">
              <span>Azure Container Apps</span>
              <span>Docker</span>
              <span>Azure DevOps CI/CD</span>
              <span>S360 Security</span>
            </div>
          </div>
        </div>

        <div class="stack-layer">
          <span class="layer-num">LAYER 03 // SYSTEMS RUNTIME</span>
          <div class="layer-content">
            <h4>TypeScript, Node.js & .NET 9</h4>
            <p>Type-safe modern web architectures and platform runtimes designed for durable reliability, zero telemetry drift, and high throughput.</p>
            <div class="stack-chips">
              <span>TypeScript</span>
              <span>Node.js</span>
              <span>.NET 9 / C#</span>
              <span>Astro</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- View 4: Daily Apps -->
    <div class="station-view view-apps" data-view="apps" hidden>
      <div class="apps-matrix">
        <div class="app-card">
          <div class="app-head">
            <span class="app-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
              </svg>
            </span>
            <div class="app-title-group">
              <h4>Raycast</h4>
              <span class="app-role">DAILY DRIVER // SHORTCUT HUB</span>
            </div>
          </div>
          <p>Instant application launcher, window management, clipboard history, custom scripts, and quick calculations. Replaces Spotlight with superhuman speed.</p>
          <kbd class="app-hotkey">⌥ + Space</kbd>
        </div>

        <div class="app-card">
          <div class="app-head">
            <span class="app-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="11" width="18" height="10" rx="2"></rect>
                <circle cx="12" cy="5" r="2"></circle>
                <path d="M12 7v4"></path>
                <line x1="8" y1="16" x2="8" y2="16"></line>
                <line x1="16" y1="16" x2="16" y2="16"></line>
              </svg>
            </span>
            <div class="app-title-group">
              <h4>ChatGPT & Claude</h4>
              <span class="app-role">ARCHITECTURE SPARRING</span>
            </div>
          </div>
          <p>Iterating on API interface designs, reviewing complex regexes, generating unit test fixtures, and technical writing draft reviews.</p>
          <kbd class="app-hotkey">⌘ + Shift + G</kbd>
        </div>

        <div class="app-card">
          <div class="app-head">
            <span class="app-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="2" y1="12" x2="22" y2="12"></line>
                <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
              </svg>
            </span>
            <div class="app-title-group">
              <h4>Google Chrome</h4>
              <span class="app-role">INSPECTOR & RUNTIME</span>
            </div>
          </div>
          <p>Primary browser for web apps, Azure portal dashboards, Chrome DevTools performance profiling, and network diagnostics.</p>
          <kbd class="app-hotkey">⌘ + ⌥ + I</kbd>
        </div>

        <div class="app-card">
          <div class="app-head">
            <span class="app-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
              </svg>
            </span>
            <div class="app-title-group">
              <h4>WhatsApp</h4>
              <span class="app-role">COMMUNICATION</span>
            </div>
          </div>
          <p>Async messaging with collaborators, engineering peers, and family across time zones.</p>
          <kbd class="app-hotkey">⌘ + 1</kbd>
        </div>
      </div>
    </div>
  </div>

  <!-- Detail Information Bar (satisfies smoke test selectors: .detail-kicker, .detail-title, .detail-copy, .detail-link) -->
  <div class="desk-detail" aria-live="polite">
    <div class="detail-meta">
      <span class="detail-kicker">01 / EDITOR & TERMINAL</span>
      <span class="detail-badge">INSPECTION ACTIVE</span>
    </div>
    <h2 class="detail-title">Where ideas become resilient code.</h2>
    <p class="detail-copy">
      Visual Studio Code, GitHub Copilot, and Ghostty. A focused, low-latency workspace from the initial architectural sketch to production deployment.
    </p>
    <a class="detail-link" href="#editor">Explore editor & terminal →</a>
  </div>
</section>

<script>
  import { playClickSound, playSuccessSound } from '../scripts/sound';

  const details: Record<string, [string, string, string, string]> = {
    editor: [
      '01 / EDITOR & TERMINAL',
      'Where ideas become resilient code.',
      'Visual Studio Code, GitHub Copilot, and Ghostty. A focused, low-latency workspace from the initial architectural sketch to production deployment.',
      'Explore editor & terminal'
    ],
    hardware: [
      '02 / HARDWARE ENGINE',
      'Small footprint. Planetary scale.',
      'The Mac Mini M4 anchors my desk setup, paired with an external high-density monitor for side-by-side IDE telemetry, and AirPods Pro 2 for focus.',
      'Explore hardware'
    ],
    stack: [
      '03 / ENGINEERING STACK',
      'Architected for the real world.',
      'TypeScript and Node.js for web and tooling. .NET 9 for high-throughput backends. Docker and Azure to orchestrate systems processing 150M+ requests daily.',
      'Explore the stack'
    ],
    apps: [
      '04 / DAILY APPS & SHORTCUTS',
      'Zero friction. Maximum velocity.',
      'Raycast for keystroke shortcuts, Chrome for developer profiling, ChatGPT for architecture sparring, and WhatsApp for connection.',
      'Explore daily apps'
    ]
  };

  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-detail]');
  const views = document.querySelectorAll<HTMLElement>('[data-view]');
  const kicker = document.querySelector('.detail-kicker');
  const title = document.querySelector('.detail-title');
  const copy = document.querySelector('.detail-copy');
  const link = document.querySelector<HTMLAnchorElement>('.detail-link');
  const detailBox = document.querySelector<HTMLElement>('.desk-detail');

  function selectStation(key: string) {
    const data = details[key];
    if (!data) return;

    tabs.forEach((tab) => {
      const isCurrent = tab.dataset.detail === key;
      tab.setAttribute('aria-pressed', String(isCurrent));
      tab.classList.toggle('active', isCurrent);
    });

    views.forEach((view) => {
      view.hidden = view.dataset.view !== key;
    });

    if (kicker) kicker.textContent = data[0];
    if (title) title.textContent = data[1];
    if (copy) copy.textContent = data[2];
    if (link) {
      link.href = `#${key}`;
      link.textContent = `${data[3]} →`;
    }

    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && detailBox) {
      detailBox.animate(
        [
          { opacity: 0.3, transform: 'translateY(6px)' },
          { opacity: 1, transform: 'translateY(0)' }
        ],
        { duration: 220, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
      );
    }

    playClickSound(1.15);
  }

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const key = tab.dataset.detail;
      if (key) selectStation(key);
    });
  });

  // Terminal interactive commands
  const termBody = document.getElementById('term-output');
  const cmdButtons = document.querySelectorAll<HTMLButtonElement>('.term-cmd-btn');

  const commandOutputs: Record<string, string> = {
    fastfetch: `
<p class="term-line"><span class="t-green">usama@mini-m4</span>:<span class="t-blue">~/workspace</span>$ fastfetch</p>
<div class="fastfetch-box">
  <span class="ff-logo">&nbsp;___&nbsp;&nbsp;__&nbsp;&nbsp;<br />|&nbsp;&nbsp;\\/&nbsp;&nbsp;|&nbsp;<br />|&nbsp;|\\/|&nbsp;|&nbsp;<br />|_|&nbsp;&nbsp;|_|&nbsp;<br /></span>
  <div class="ff-info">
    <span class="ff-row"><b class="t-cyan">OS:</b> macOS Sequoia 15.3 (arm64)</span>
    <span class="ff-row"><b class="t-cyan">Host:</b> Mac mini (M4, 2024)</span>
    <span class="ff-row"><b class="t-cyan">Uptime:</b> 12+ years in cloud engineering</span>
    <span class="ff-row"><b class="t-cyan">Shell:</b> zsh 5.9 + starship</span>
    <span class="ff-row"><b class="t-cyan">Terminal:</b> Ghostty (native Metal GPU)</span>
    <span class="ff-row"><b class="t-cyan">Editor:</b> VS Code + Copilot</span>
  </div>
</div>`,
    status: `
<p class="term-line"><span class="t-green">usama@mini-m4</span>:<span class="t-blue">~/workspace</span>$ status</p>
<div class="ff-info" style="margin: 0.5rem 0;">
  <span class="ff-row"><b class="t-green">● AI AGENT PLATFORM:</b> 10+ Production Agents | 52 Users | 712M Monthly Tokens</span>
  <span class="ff-row"><b class="t-green">● DEVICE HEALTH API:</b> 150M req/day | 99.999% SLA across 3M+ Azure Nodes</span>
  <span class="ff-row"><b class="t-green">● S360 SECURITY:</b> 100% Compliant</span>
</div>`,
    'cat stack.json': `
<p class="term-line"><span class="t-green">usama@mini-m4</span>:<span class="t-blue">~/workspace</span>$ cat stack.json</p>
<pre style="margin: 0.4rem 0; padding: 0.5rem; background: rgba(0,0,0,0.3) !important; font-size: 0.75rem;">
{
  "languages": ["TypeScript", "C#", "SQL"],
  "runtime": [".NET 9", "Node.js", "Astro"],
  "cloud": ["Azure AI Foundry", "Container Apps", "Cosmos DB", "Docker"],
  "protocol": ["Model Context Protocol (MCP)"]
}</pre>`
  };

  cmdButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const cmd = btn.dataset.cmd;
      if (!cmd || !termBody) return;

      if (cmd === 'clear') {
        termBody.innerHTML = `<p class="term-line prompt-line"><span class="t-green">usama@mini-m4</span>:<span class="t-blue">~/workspace</span>$&nbsp;<span class="cursor">▍</span></p>`;
      } else {
        const out = commandOutputs[cmd] || `<p class="term-line">${cmd}: command executed</p>`;
        const promptLine = termBody.querySelector('.prompt-line');
        if (promptLine) {
          promptLine.insertAdjacentHTML('beforebegin', out);
        } else {
          termBody.innerHTML += out;
        }
      }
      playSuccessSound();
      termBody.scrollTop = termBody.scrollHeight;
    });
  });
</script>

<style>
  .workbench {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
    margin: 0 0 4rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .desk-topline {
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.85rem;
  }

  .topline-left {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .topline-title {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #111111;
  }

  .topline-hint {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--text-muted);
    letter-spacing: 0.04em;
  }

  /* Station Dock Tabs */
  .station-dock {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.75rem;
  }

  .station-tab {
    background: var(--surface-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.85rem 1rem;
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
    text-align: left;
    transition: background-color 140ms var(--ease-out), border-color 140ms var(--ease-out);
    color: #111111;
    font-family: var(--font-ui);
    box-shadow: var(--shadow-sm);
  }

  .station-tab:active {
    transform: scale(0.98);
  }

  @media (hover: hover) and (pointer: fine) {
    .station-tab:hover {
      background: var(--surface-alt);
      border-color: var(--border-dark);
    }
  }

  .station-tab.active,
  .station-tab[aria-pressed="true"] {
    background: var(--surface-alt);
    border-color: #111111;
    box-shadow: var(--shadow-sm);
  }

  .tab-index {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .station-tab.active .tab-index {
    color: #111111;
  }

  .tab-info {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .tab-name {
    font-size: 0.84rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .tab-sub {
    font-size: 0.7rem;
    color: var(--text-muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Station Display Area */
  .workbench-display {
    min-height: 320px;
    background: #18181B;
    border-radius: 6px;
    border: 1px solid var(--border);
    padding: 1.4rem;
    color: #F4F4F5;
    box-shadow: var(--shadow-sm);
    display: flex;
    flex-direction: column;
  }

  .station-view {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  /* Terminal Window */
  .terminal-window {
    display: flex;
    flex-direction: column;
    height: 100%;
    gap: 0.85rem;
    font-family: var(--font-code);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .term-dots {
    display: flex;
    gap: 6px;
  }

  .term-dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.25);
  }

  .term-tabs {
    display: flex;
    gap: 0.5rem;
  }

  .term-tab {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    border-radius: 3px;
    background: rgba(255, 255, 255, 0.05);
    color: #A1A1AA;
  }

  .term-tab.active {
    background: rgba(255, 255, 255, 0.12);
    color: #FFFFFF;
    font-weight: 500;
  }

  .term-tag {
    font-size: 0.65rem;
    color: #A1A1AA;
    letter-spacing: 0.04em;
  }

  .terminal-body {
    flex: 1;
    font-size: 0.82rem;
    line-height: 1.6;
    overflow-y: auto;
    max-height: 220px;
  }

  .term-line {
