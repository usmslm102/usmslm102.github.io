---
const parts = [
  { id: 'hardware', key: '⌘', label: 'Hardware', title: 'Small footprint. Serious capability.', description: 'A Mac mini M4, an external display, and AirPods Pro. A quiet, focused foundation for deep work.', link: 'Explore hardware' },
  { id: 'editor', key: '{ }', label: 'Editor', title: 'From a thought to a working thing.', description: 'VS Code for the big picture. Ghostty for the fast path. GitHub Copilot when an extra pair of hands helps.', link: 'Explore the editor & terminal' },
  { id: 'stack', key: '>_', label: 'Stack', title: 'The right tool for the system.', description: 'TypeScript and Node.js for orchestration. C# and .NET for services. Docker and Azure to bring it all together.', link: 'Explore the engineering stack' },
  { id: 'apps', key: '↗', label: 'Apps', title: 'Less friction. More headspace.', description: 'Raycast for the everyday shortcuts, Chrome for the web, and AI assistants for thinking things through.', link: 'Explore daily apps' },
];
---
<section class="desk" data-parts={JSON.stringify(parts)} aria-label="Interactive workspace" data-reveal>
  <div class="desk-keys" role="group" aria-label="Explore the workspace">{parts.map((part, i) => <button class={`desk-key desk-key-${i}`} type="button" data-detail={part.id} aria-pressed={i === 0} aria-controls="desk-detail"><span class="key-symbol" aria-hidden="true">{part.key}</span><span>{part.label}</span></button>)}</div>
  <div class="desk-detail" id="desk-detail" aria-live="polite"><span class="desk-label">{parts[0].label}</span><h2 class="detail-title">{parts[0].title}</h2><p class="detail-description">{parts[0].description}</p><a class="text-link detail-link" href="#hardware">{parts[0].link} <span aria-hidden="true">↗</span></a></div>
</section>
<script>
  const parts: { id: string; label: string; title: string; description: string; link: string }[] = JSON.parse(document.querySelector<HTMLElement>('[data-parts]')?.dataset.parts || '[]');
  (() => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-detail]');
    const detail = document.getElementById('desk-detail');
    buttons.forEach(button => button.addEventListener('click', () => {
      const part = parts.find(item => item.id === button.dataset.detail);
      if (!part || !detail) return;
      buttons.forEach(item => item.setAttribute('aria-pressed', String(item === button)));
      detail.querySelector('.desk-label')!.textContent = part.label;
      detail.querySelector('.detail-title')!.textContent = part.title;
      detail.querySelector('.detail-description')!.textContent = part.description;
      const link = detail.querySelector<HTMLAnchorElement>('.detail-link')!; link.href = '#' + part.id; link.firstChild!.textContent = part.link + ' ';
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) detail.animate([{ opacity: .2, transform: 'translateY(10px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 350, easing: 'cubic-bezier(.16,1,.3,1)' });
    }));
  })();
</script>
<style>
  .desk { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 6vw, 6rem); align-items: center; padding: clamp(2rem, 5vw, 5rem); background: var(--surface-alt); border-radius: var(--radius); }
  .desk-keys { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; padding: 1.5rem; perspective: 800px; transform: rotate(-8deg); }
  .desk-key { display: flex; flex-direction: column; align-items: start; justify-content: space-between; aspect-ratio: 1; border: 1px solid var(--border); background: var(--surface-card); border-radius: 18px; padding: 1.5rem; box-shadow: 0 8px 0 var(--surface-sunken), 0 16px 20px #111b3610; transform: rotateX(12deg); font-size: .75rem; transition: transform 300ms var(--ease-out), background 200ms, color 200ms; }
  .desk-key .key-symbol { font-family: var(--font-display); font-size: clamp(2rem, 4vw, 3.5rem); line-height: 1; }
  .desk-key[aria-pressed='true'] { background: var(--accent); color: var(--on-accent); border-color: var(--accent); box-shadow: 0 8px 0 var(--accent-hover), 0 16px 20px #111b3610; }
  .desk-key:hover { transform: rotateX(12deg) translateY(-6px); }
  .desk-key:active { transform: rotateX(12deg) translateY(4px); }
  .desk-label { display: block; color: var(--accent); font-size: .75rem; margin-bottom: 1.5rem; }
  .detail-title { font-size: clamp(2rem, 3.8vw, 3.5rem); max-width: 18ch; }
  .detail-description { margin-top: 1.5rem; color: var(--text-body); font-size: .95rem; max-width: 42ch; }
  .detail-link { margin-top: 1.5rem; }
  @media (max-width: 768px) { .desk { grid-template-columns: 1fr; } .desk-keys { max-width: 360px; margin-inline: auto; width: 100%; } .desk-detail { min-height: 260px; } }
  @media (max-width: 380px) { .desk { padding: 1.5rem; } .desk-keys { gap: 1rem; padding: .5rem; } .desk-key { padding: 1rem; } }
</style>
