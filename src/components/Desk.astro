<section class="workbench" aria-label="Interactive desk tour">
 <div class="desk-topline"><span>THE WORKBENCH</span><span>SELECT AN OBJECT TO EXPLORE ↓</span></div>
 <div class="desk-scene">
  <button class="monitor desk-object" data-detail="editor" aria-label="Explore my editor and terminal" aria-pressed="true"><span class="screen"><span class="window-dots">● ● ●</span><span class="screen-code">const life = &#123;<br />&nbsp; build: 'with care',<br />&nbsp; learn: 'every day',<br />&nbsp; coffee: true<br />&#125;;<br /><span class="cursor">▍</span></span></span><span class="stand"></span><span class="object-label">01 / THE EDITOR</span></button>
  <button class="mini desk-object" data-detail="hardware" aria-label="Explore my Mac Mini M4" aria-pressed="false"><span class="mini-box">M4<span class="power-dot"></span></span><span class="object-label">02 / THE ENGINE</span></button>
  <button class="keys desk-object" data-detail="stack" aria-label="Explore my engineering stack" aria-pressed="false"><span class="key-grid" aria-hidden="true">{Array.from({length:30},()=> <i></i>)}</span><span class="object-label">03 / THE STACK</span></button>
  <button class="app-disc desk-object" data-detail="apps" aria-label="Explore my daily apps" aria-pressed="false"><span class="disc">↗</span><span class="object-label">04 / THE SHORTCUTS</span></button>
 </div>
 <div class="desk-detail" aria-live="polite"><span class="detail-kicker">01 / EDITOR & TERMINAL</span><h2 class="detail-title">Where ideas become code.</h2><p class="detail-copy">Visual Studio Code, GitHub Copilot, and Ghostty. A focused workspace, from the first line to the final commit.</p><a class="detail-link" href="#editor">Explore editor & terminal →</a></div>
</section>
<script>
const details = {
    editor: ['01 / EDITOR & TERMINAL', 'Where ideas become code.', 'Visual Studio Code, GitHub Copilot, and Ghostty. A focused workspace, from the first line to the final commit.', 'Explore editor & terminal'],
    hardware: ['02 / HARDWARE', 'Small footprint. Big possibility.', 'The Mac Mini M4 anchors my setup, with an external monitor for code and documentation side by side, and AirPods Pro 2.', 'Explore hardware'],
    stack: ['03 / ENGINEERING STACK', 'Built for the real world.', 'TypeScript and Node.js for web and tooling. .NET for the backend. Docker and Azure to get it out into the world.', 'Explore the stack'],
    apps: ['04 / DAILY APPS', 'Less friction. More focus.', 'Raycast for shortcuts, Chrome for the web, ChatGPT for research and drafting, and WhatsApp to stay connected.', 'Explore daily apps']
};
document.querySelectorAll<HTMLButtonElement>('[data-detail]').forEach(button => button.addEventListener('click', () => {
    const key = button.dataset.detail as keyof typeof details;
    const data = details[key];
    document.querySelectorAll('[data-detail]').forEach(item => item.setAttribute('aria-pressed', String(item === button)));
    document.querySelector('.detail-kicker')!.textContent = data[0];
    document.querySelector('.detail-title')!.textContent = data[1];
    document.querySelector('.detail-copy')!.textContent = data[2];
    const link = document.querySelector<HTMLAnchorElement>('.detail-link')!;
    link.href = `#${key}`;
    link.textContent = `${data[3]} →`;
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches)
        document.querySelector('.desk-detail')!.animate([{ opacity: .3, transform: 'translateY(6px)' }, { opacity: 1, transform: 'translateY(0)' }], { duration: 250, easing: 'ease-out' });
}));
</script>
