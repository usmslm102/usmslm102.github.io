---
import { Search, Sun, Moon, Menu, X } from '@lucide/astro';
import { SITE_TITLE } from '../consts';
import CommandPalette from './CommandPalette.astro';
const links = [['/', 'Home'], ['/work', 'Work'], ['/blog', 'Blog'], ['/uses', 'Uses'], ['/about', 'About'], ['/r', 'Resume'], ['/contact', 'Contact']];
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <nav class="container nav-container" aria-label="Primary navigation">
    <a class="brand" href="/" aria-label={`${SITE_TITLE}, home`}>{SITE_TITLE}<span aria-hidden="true">*</span></a>
    <div class="nav-links" id="navigation-links">
      {links.map(([href, label]) => <a href={href} aria-current={pathname === href || href === '/blog' && pathname.startsWith('/blog/') ? 'page' : undefined}>{label}</a>)}
    </div>
    <div class="nav-tools">
      <button class="search-trigger" data-open-cmd aria-label="Search pages and articles (⌘ K)"><Search class="icon search-icon" aria-hidden="true" /><span>Search</span><kbd>⌘ K</kbd></button>
      <button class="theme-toggle" type="button" aria-label="Switch to dark theme" title="Switch theme"><Sun class="icon theme-sun" aria-hidden="true" /><Moon class="icon theme-moon" aria-hidden="true" /></button>
      <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="navigation-links"><span class="menu-label">Menu</span><Menu class="icon menu-open-icon" aria-hidden="true" /><X class="icon menu-close-icon" aria-hidden="true" /></button>
    </div>
  </nav>
</header>
<CommandPalette />
<script>
  const root = document.documentElement;
  const themeButton = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const media = matchMedia('(prefers-color-scheme: dark)');
  const updateTheme = () => {
    const dark = root.dataset.theme === 'dark';
    themeButton?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} theme`);
    document.querySelector('meta[name="theme-color"]')?.setAttribute('content', dark ? '#15171e' : '#f7f8fa');
    window.dispatchEvent(new Event('theme-change'));
  };
  themeButton?.addEventListener('click', () => {
    root.dataset.theme = root.dataset.theme === 'dark' ? 'light' : 'dark';
    try { localStorage.setItem('theme', root.dataset.theme); } catch {}
    updateTheme();
  });
  media.addEventListener('change', (event) => {
    let saved = null;
    try { saved = localStorage.getItem('theme'); } catch {}
    if (!saved) { root.dataset.theme = event.matches ? 'dark' : 'light'; updateTheme(); }
  });
  updateTheme();
  const menu = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const links = document.querySelector<HTMLElement>('.nav-links');
  const closeMenu = () => { menu?.setAttribute('aria-expanded', 'false'); menu?.setAttribute('aria-label', 'Open menu'); links?.classList.remove('is-open'); };
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') !== 'true';
    menu.setAttribute('aria-expanded', String(open));
    menu.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    links?.classList.toggle('is-open', open);
  });
  document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && links?.classList.contains('is-open')) { closeMenu(); menu?.focus(); } });
  document.addEventListener('click', event => { if (!(event.target as HTMLElement).closest('.site-header')) closeMenu(); });
  links?.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
  matchMedia('(min-width: 901px)').addEventListener('change', closeMenu);
</script>
<style>
  .site-header { position: sticky; top: 0; z-index: var(--layer-header); background: var(--surface); border-bottom: 1px solid var(--border); }
  .nav-container { min-height: 80px; display: flex; align-items: center; justify-content: space-between; gap: 2rem; }
  .brand { display: inline-flex; align-items: start; gap: .35rem; font-family: var(--font-display); font-weight: 700; letter-spacing: -.06em; font-size: 1.4rem; white-space: nowrap; }
  .brand > span { color: var(--accent); font-size: .75rem; margin-top: .25rem; }
  .nav-links { display: flex; align-items: center; gap: 1.5rem; }
  .nav-links a { position: relative; display: inline-flex; align-items: center; min-height: 44px; color: var(--text-body); font-size: .85rem; }
  .nav-links a::after { content: ''; position: absolute; bottom: 3px; left: 0; width: 100%; height: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 250ms var(--ease-out); }
  .nav-links a[aria-current], .nav-links a:hover { color: var(--text); }
  .nav-links a[aria-current]::after, .nav-links a:hover::after { transform: scaleX(1); }
  .nav-tools { display: flex; align-items: center; gap: .75rem; }
  .search-trigger { display: inline-flex; align-items: center; gap: 1.4rem; min-height: 44px; padding: 0 .75rem; background: transparent; border: 1px solid var(--border); border-radius: 100px; color: var(--text-body); font-size: .78rem; }
  kbd { font-family: var(--font-body); color: var(--text-muted); font-size: .75rem; }
  .theme-toggle { width: 44px; height: 44px; display: grid; place-items: center; border: 1px solid var(--border); border-radius: 50%; background: transparent; }
  .theme-toggle :global(.icon) { width: 18px; height: 18px; }
  .theme-sun, :global([data-theme='dark']) .theme-moon { display: none; }
  :global([data-theme='dark']) .theme-sun { display: block; }
  .menu-toggle { display: none; border: 0; background: transparent; min-height: 44px; min-width: 44px; padding: 0; gap: .65rem; align-items: center; justify-content: center; font-size: .8rem; }
  .menu-toggle :global(.icon) { width: 20px; height: 20px; }
  .menu-close-icon, .menu-toggle[aria-expanded='true'] .menu-open-icon { display: none; }
  .menu-toggle[aria-expanded='true'] .menu-close-icon { display: block; }
  @media (max-width: 1100px) { .nav-container { gap: 1rem; } .nav-links { gap: 1rem; } .search-trigger > span { display: none; } .search-trigger { gap: .5rem; } }
  @media (max-width: 900px) {
    .nav-container { min-height: 72px; flex-wrap: wrap; }
    .nav-links { order: 3; width: 100%; display: none; grid-template-columns: repeat(3, 1fr); gap: .5rem 1.5rem; padding-bottom: 1.5rem; }
    .nav-links.is-open { display: grid; animation: enter 300ms var(--ease-out); }
    .menu-toggle { display: inline-flex; }
    .nav-tools { gap: .75rem; }
  }
  @media (max-width: 640px) { .brand { font-size: 1.15rem; } .nav-container { gap: .5rem; } .nav-tools { gap: .4rem; } .menu-label { display: none; } }
  @media (scripting: none) { .nav-links { display: flex; flex-wrap: wrap; } .nav-tools { display: none; } }
</style>
