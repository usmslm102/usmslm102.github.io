---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import CommandPalette from './CommandPalette.astro';
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
	<nav aria-label="Primary navigation" class="nav-container">
		<div class="brand-group">
			<a class="brand" href="/">
				<span class="brand-name">{SITE_TITLE}</span>
			</a>
		</div>

		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/uses">Uses</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/r">Resume</HeaderLink>
			<HeaderLink href="/contact">Contact</HeaderLink>
		</div>

		<div class="header-tools">
			<button type="button" class="cmd-trigger-btn" data-open-cmd aria-label="Open Command Palette (Press ⌘K)">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="11" cy="11" r="8"></circle>
					<line x1="21" y1="21" x2="16.65" y2="16.65"></line>
				</svg>
				<span class="cmd-text">Search</span>
				<kbd class="cmd-kbd">⌘K</kbd>
			</button>

			<button type="button" class="sound-toggle-btn" id="header-sound-btn" aria-label="Toggle Sound Effects" title="Toggle tactile sound effects">
				<span class="sound-icon" aria-hidden="true">♫</span>
				<span class="sound-label sr-only">Sound Effects</span>
			</button>

			<div class="social-links">
				<a href="https://github.com/usmslm102" target="_blank" rel="noreferrer" title="GitHub Profile">
					GitHub
				</a>
				<a href="https://www.linkedin.com/in/usamaansari/" target="_blank" rel="noreferrer" title="LinkedIn Profile">
					LinkedIn
				</a>
			</div>
		</div>
	</nav>
</header>
<CommandPalette />

<script>
	import { toggleSound, isSoundEnabled, playClickSound } from '../scripts/sound';

	const soundBtn = document.getElementById('header-sound-btn');

	function updateSoundUI() {
		const enabled = isSoundEnabled();
		if (soundBtn) {
			soundBtn.classList.toggle('sound-active', enabled);
			soundBtn.setAttribute('aria-pressed', String(enabled));
			soundBtn.setAttribute('title', enabled ? 'Sound FX: ON (Click to mute)' : 'Sound FX: OFF (Click to unmute)');
		}
	}

	soundBtn?.addEventListener('click', () => {
		toggleSound();
		updateSoundUI();
	});

	window.addEventListener('sound-toggle', updateSoundUI);
	updateSoundUI();

	// Add tactile audio clicks to nav links
	document.querySelectorAll('.internal-links a').forEach(link => {
		link.addEventListener('mouseenter', () => playClickSound(1.3));
	});
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: color-mix(in oklch, var(--surface) 88%, transparent);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid color-mix(in oklch, var(--ink-blue) 14%, rgb(var(--gray-light)));
		transition: background-color 200ms ease;
	}

	.nav-container {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		min-height: 4.25rem;
		margin: 0 auto;
		max-width: 1100px;
		padding: 0 1.25rem;
		box-sizing: border-box;
	}

	.brand-group {
		display: flex;
		align-items: center;
		gap: 0.85rem;
	}

	.brand {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 400;
		letter-spacing: -0.02em;
		text-decoration: none;
		color: rgb(var(--black));
		display: inline-flex;
		align-items: baseline;
	}

	.brand:hover {
		background: transparent;
		color: var(--accent);
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 0.25rem;
	}

	.internal-links :global(a) {
		display: inline-flex;
		align-items: center;
		padding: 0.4rem 0.75rem;
		min-height: 2.25rem;
		color: rgb(var(--gray-dark));
		text-decoration: none;
		font-family: var(--font-ui);
		font-weight: 500;
		font-size: 0.86rem;
		border-radius: 6px;
		transition: color 140ms var(--ease-out), background-color 140ms var(--ease-out), transform 140ms var(--ease-out);
	}

	.internal-links :global(a.active) {
		color: var(--accent-dark);
		font-weight: 700;
		background-color: var(--accent-soft);
	}

	.internal-links :global(a:active) {
		transform: scale(0.97);
	}

	@media (hover: hover) and (pointer: fine) {
		.internal-links :global(a:hover) {
			color: rgb(var(--black));
			background-color: var(--surface-alt);
		}
	}

	.header-tools {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.cmd-trigger-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.65rem;
		background: var(--surface-card);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		color: rgb(var(--gray));
		font-family: var(--font-ui);
		font-size: 0.8rem;
		cursor: pointer;
		transition: transform 140ms var(--ease-out), border-color 140ms var(--ease-out), color 140ms var(--ease-out), box-shadow 140ms var(--ease-out);
	}

	.cmd-trigger-btn:active {
		transform: scale(0.97);
	}

	@media (hover: hover) and (pointer: fine) {
		.cmd-trigger-btn:hover {
			border-color: var(--accent);
			color: rgb(var(--black));
			box-shadow: 0 2px 6px var(--accent-glow);
		}
	}

	.cmd-kbd {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		padding: 0.1rem 0.35rem;
		background: var(--surface-alt);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 4px;
		color: rgb(var(--gray-dark));
	}

	.sound-toggle-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 32px;
		height: 32px;
		background: var(--surface-card);
		border: 1px solid rgb(var(--gray-light));
		border-radius: 6px;
		color: rgb(var(--gray));
		font-size: 0.88rem;
		cursor: pointer;
		transition: transform 140ms var(--ease-out), border-color 140ms var(--ease-out), color 140ms var(--ease-out), background-color 140ms var(--ease-out);
	}

	.sound-toggle-btn:active {
		transform: scale(0.97);
	}

	@media (hover: hover) and (pointer: fine) {
		.sound-toggle-btn:hover {
			color: rgb(var(--black));
			border-color: rgb(var(--gray));
		}
	}

	.sound-toggle-btn.sound-active {
		background: var(--accent-soft);
		border-color: var(--accent);
		color: var(--accent-dark);
	}

	.social-links {
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}

	.social-links a {
		display: inline-flex;
		align-items: center;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--ink-blue);
		text-decoration: none;
		padding: 0.35rem 0.5rem;
		border-radius: 5px;
		transition: color 140ms var(--ease-out), background-color 140ms var(--ease-out), transform 140ms var(--ease-out);
	}

	.social-links a:active {
		transform: scale(0.97);
	}

	@media (hover: hover) and (pointer: fine) {
		.social-links a:hover {
			background: var(--accent-soft);
			color: var(--accent-dark);
		}
	}

	@media (max-width: 760px) {
		.nav-container {
			flex-wrap: wrap;
			padding: 0.5rem 1rem;
			min-height: auto;
			gap: 0.5rem;
		}

		.brand-group {
			order: 1;
		}

		.header-tools {
			order: 2;
			margin-left: auto;
		}

		.cmd-text {
			display: none;
		}

		.social-links {
			display: none;
		}

		.internal-links {
			order: 3;
			width: 100%;
			overflow-x: auto;
			padding-bottom: 0.25rem;
			gap: 0.2rem;
			-webkit-overflow-scrolling: touch;
		}

		.internal-links :global(a) {
			padding: 0.3rem 0.6rem;
			font-size: 0.8rem;
			white-space: nowrap;
		}
	}
</style>
