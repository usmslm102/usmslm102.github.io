---
import { Pause, Play } from '@lucide/astro';
---
<div class="sculpture" data-sculpture>
  <div class="sculpture-stage">
    <div class="sculpture-fallback" aria-hidden="true"></div>
    <canvas aria-label="A sculptural cobalt loop, made of interconnected moving ribbons" role="img"></canvas>
  </div>
  <div class="sculpture-caption"><span>Independent parts. One system.</span><button type="button" data-motion-toggle aria-label="Pause motion" aria-pressed="false" hidden><Pause class="icon motion-pause" aria-hidden="true" /><Play class="icon motion-play" aria-hidden="true" /><span data-motion-label>Pause</span></button></div>
</div>
<script>
  const sculpture = document.querySelector<HTMLElement>('[data-sculpture]');
  if (sculpture) {
    const canvas = sculpture.querySelector('canvas')!;
    const context = canvas.getContext('2d');
    const button = sculpture.querySelector<HTMLButtonElement>('[data-motion-toggle]')!;
    const label = sculpture.querySelector('[data-motion-label]')!;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = matchMedia('(hover: hover) and (pointer: fine)');
    let paused = false;
    try { paused = sessionStorage.getItem('sculpture-paused') === 'true'; } catch {}
    let visible = true, frame = 0, lastTime = 0, phase = .65, size = 0;
    let pointerX = 0, pointerY = 0, leanX = 0, leanY = 0;
    let dark = document.documentElement.dataset.theme === 'dark';
    type Point = [number, number, number];
    type Face = { points: Point[]; light: number };
    const geometry: Face[] = [];
    // Discrete ribbons form a continuous torus. Geometry is built once, not each frame.
    const ringCount = matchMedia('(max-width: 640px)').matches ? 48 : 64, segments = 24;
    const point = (u: number, v: number): Point => {
      const tube = .42 + Math.sin(u * 3) * .045;
      const radius = 1 + tube * Math.cos(v);
      return [radius * Math.cos(u), radius * Math.sin(u), tube * Math.sin(v)];
    };
    for (let i = 0; i < ringCount; i++) {
      const u = i / ringCount * Math.PI * 2;
      const next = u + Math.PI * 2 / ringCount * .76;
      for (let j = 0; j < segments; j++) {
        const v = j / segments * Math.PI * 2;
        const v2 = (j + 1) / segments * Math.PI * 2;
        geometry.push({ points: [point(u, v), point(next, v), point(next, v2), point(u, v2)], light: Math.cos(v + .8) * .5 + Math.sin(u - .5) * .2 });
      }
    }
    const faces = geometry.map(face => ({ source: face.points, points: face.points.map(() => [0, 0, 0]), depth: 0, light: face.light }));
    function draw() {
      if (!context || !size) return;
      context.clearRect(0, 0, size, size);
      const ax = .75 + leanY * .22, ay = .35 + Math.sin(phase * .6) * .25 + leanX * .3, az = phase * .22 - .4;
      const cx = Math.cos(ax), sx = Math.sin(ax), cy = Math.cos(ay), sy = Math.sin(ay), cz = Math.cos(az), sz = Math.sin(az);
      // Reuse projected vertices to avoid thousands of allocations per frame.
      for (const face of faces) {
        let depth = 0;
        for (let i = 0; i < 4; i++) {
          const [x, y, z] = face.source[i];
          const y1 = y * cx - z * sx, z1 = y * sx + z * cx;
          const x2 = x * cy + z1 * sy, z2 = -x * sy + z1 * cy;
          const x3 = x2 * cz - y1 * sz, y3 = x2 * sz + y1 * cz;
          const perspective = 5 / (5 - z2);
          face.points[i][0] = size / 2 + x3 * size * .28 * perspective;
          face.points[i][1] = size / 2 + y3 * size * .28 * perspective;
          depth += z2;
        }
        face.depth = depth / 4;
      }
      faces.sort((a, b) => a.depth - b.depth);
      for (const face of faces) {
        const light = Math.max(0, Math.min(1, .42 + face.light * .35 + face.depth * .17));
        const shine = Math.pow(light, 3);
        const r = (dark ? 42 : 22) + 108 * shine;
        const g = (dark ? 66 : 48) + 118 * shine;
        const b = 160 + 92 * light;
        context.fillStyle = `rgb(${r}, ${g}, ${b})`;
        context.beginPath();
        face.points.forEach((p, i) => i === 0 ? context.moveTo(p[0], p[1]) : context.lineTo(p[0], p[1]));
        context.closePath();
        context.fill();
      }
      sculpture?.classList.add('is-rendered');
    }
    const shouldAnimate = () => !paused && !reduced.matches && visible && !document.hidden;
    function tick(time: number) {
      frame = 0;
      if (!shouldAnimate()) return;
      const delta = lastTime ? Math.min(time - lastTime, 50) : 16;
      lastTime = time;
      phase += delta * .00045;
      leanX += (pointerX - leanX) * .055;
      leanY += (pointerY - leanY) * .055;
      draw();
      frame = requestAnimationFrame(tick);
    }
    function sync() {
      cancelAnimationFrame(frame); frame = 0; lastTime = 0;
      const stopped = paused || reduced.matches;
      button.setAttribute('aria-label', reduced.matches ? 'Reduced motion' : stopped ? 'Resume motion' : 'Pause motion');
      button.setAttribute('aria-pressed', String(stopped));
      button.disabled = reduced.matches;
      label.textContent = reduced.matches ? 'Reduced motion' : paused ? 'Resume' : 'Pause';
      sculpture?.classList.toggle('paused', stopped);
      draw();
      if (shouldAnimate()) frame = requestAnimationFrame(tick);
    }
    if (context) {
      button.hidden = false;
      const resize = new ResizeObserver(entries => {
        size = entries[0].contentRect.width;
        const dpr = Math.min(devicePixelRatio || 1, 2);
        canvas.width = Math.round(size * dpr); canvas.height = Math.round(size * dpr);
        context.setTransform(dpr, 0, 0, dpr, 0, 0); draw();
      });
      resize.observe(canvas);
      const intersection = new IntersectionObserver(entries => { visible = entries[0].isIntersecting; sync(); });
      intersection.observe(sculpture);
      sculpture.addEventListener('pointermove', event => {
        if (!finePointer.matches || reduced.matches || paused) return;
        const rect = sculpture.getBoundingClientRect();
        pointerX = (event.clientX - rect.left) / rect.width * 2 - 1;
        pointerY = (event.clientY - rect.top) / rect.height * 2 - 1;
      });
      sculpture.addEventListener('pointerleave', () => { pointerX = 0; pointerY = 0; });
      button.addEventListener('click', () => { paused = !paused; try { sessionStorage.setItem('sculpture-paused', String(paused)); } catch {} sync(); });
      reduced.addEventListener('change', sync);
      document.addEventListener('visibilitychange', sync);
      window.addEventListener('theme-change', () => { dark = document.documentElement.dataset.theme === 'dark'; draw(); });
      window.addEventListener('pagehide', () => cancelAnimationFrame(frame));
      window.addEventListener('pageshow', sync);
      sync();
    }
  }
</script>
<style>
  .sculpture { width: 100%; position: relative; }
  .sculpture-stage { aspect-ratio: 1; position: relative; }
  canvas { display: block; width: 100%; height: 100%; position: relative; }
  .sculpture-fallback { position: absolute; width: 70%; height: 70%; left: 15%; top: 15%; border: clamp(30px, 5vw, 70px) solid var(--accent); border-radius: 50%; transform: rotateX(28deg) rotateY(-20deg) rotate(-30deg); }
  .is-rendered .sculpture-fallback { display: none; }
  .sculpture-caption { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .5rem .5rem 0; font-size: .75rem; color: var(--text-muted); }
  [data-motion-toggle] { display: inline-flex; align-items: center; gap: .5rem; background: transparent; border: 0; border-radius: 100px; padding: .5rem; min-height: 44px; font-size: .72rem; white-space: nowrap; }
  [data-motion-toggle]:hover { color: var(--accent); }
  [data-motion-toggle]:disabled { cursor: default; }
  .motion-play, .paused .motion-pause { display: none; }
  .paused .motion-play { display: inline-block; }
</style>
