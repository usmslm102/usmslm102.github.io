---
import { Image } from 'astro:assets';
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import ReadingTools from '../components/ReadingTools.astro';

type Props = CollectionEntry<'blog'>['data'] & { id?: string };

const { title, description, pubDate, updatedDate, heroImage, id } = Astro.props;

// Construct the URL logically
const githubRepoPath = "https://github.com/usmslm102/usmslm102.github.io/blob/master/src/content/blog";
const editUrl = id ? `${githubRepoPath}/${id}.md` : null;

// More posts for footer navigation
const allPosts = (await getCollection('blog'))
	.filter((p) => p.id !== id)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 2);
---

<html lang="en">
	<head>
		<BaseHead title={`${title} — Usama Ansari`} description={description} />
	</head>

	<body>
		<Header />
		<main id="main-content" tabindex="-1" class="post-page">
			<div class="article-shell">
				<!-- Back link -->
				<a class="back" href="/blog">&larr; All posts</a>

				<article class="article-body">
					<!-- Title and Metadata -->
					<header class="title-header">
						<div class="meta-bar">
							<div class="date-group">
								<p class="pub-date">
									<FormattedDate date={pubDate} />
								</p>
								{
									updatedDate && (
										<p class="last-updated-on">(Updated <FormattedDate date={updatedDate} />)</p>
									)
								}
							</div>
							{editUrl && (
								<a href={editUrl} class="github-edit-btn" target="_blank" rel="noopener noreferrer">
									<span>Edit on GitHub</span> &#8599;
								</a>
							)}
						</div>

						<h1 class="post-h1">{title}</h1>
						{description && description.trim().toLowerCase() !== title.trim().toLowerCase() && (
							<p class="post-lead">{description}</p>
						)}
					</header>

					{heroImage && (
						<div class="hero-image">
							<Image width={1020} height={510} src={heroImage} alt="" class="hero-img-el" />
						</div>
					)}

					<!-- Reading Progress and TOC tools -->
					<ReadingTools />

					<!-- Main Article Content -->
					<div class="prose">
						<slot />
					</div>
				</article>

				<!-- Post Footer: Read More -->
				{allPosts.length > 0 && (
					<section class="read-next-section" aria-label="Related articles">
						<h3 class="read-next-title">Continue Reading</h3>
						<div class="read-next-grid">
							{allPosts.map((post) => (
								<a href={`/blog/${post.id}/`} class="read-next-card">
									<span class="read-next-date">
										<FormattedDate date={post.data.pubDate} />
									</span>
									<h4>{post.data.title}</h4>
									<span class="read-next-arrow">Read guide ↗</span>
								</a>
							))}
						</div>
					</section>
				)}
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.post-page {
		width: 100%;
		max-width: 900px;
		margin: auto;
		padding: 3rem 1.5rem 5rem;
		box-sizing: border-box;
	}

	.article-shell {
		width: 100%;
		max-width: 700px;
		margin: 0 auto;
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		margin-bottom: 2rem;
		font-size: 0.76rem;
		text-decoration: none;
		font-family: var(--font-mono);
		font-weight: 500;
		color: #111111;
		border: 1px solid var(--border);
		background: var(--surface-card);
		border-radius: 4px;
		padding: 0.35rem 0.75rem;
		transition: background-color 140ms var(--ease-out), border-color 140ms var(--ease-out);
	}

	.back:active {
		transform: scale(0.98);
	}

	@media (hover: hover) and (pointer: fine) {
		.back:hover {
			background: var(--surface-alt);
			border-color: #111111;
			text-decoration: none;
		}
	}

	.title-header {
		margin-bottom: 2rem;
		padding-bottom: 1.5rem;
		border-bottom: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		gap: 0.85rem;
	}

	.meta-bar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-muted);
		flex-wrap: wrap;
	}

	.date-group {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.pub-date {
		margin: 0;
		color: var(--text-muted);
		font-weight: 500;
	}

	.last-updated-on {
		margin: 0;
		font-style: italic;
	}

	.github-edit-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		color: var(--text-muted);
		text-decoration: none;
		font-size: 0.7rem;
		font-weight: 500;
		padding: 0.15rem 0.45rem;
		border: 1px solid var(--border);
		border-radius: 3px;
		background: var(--surface-alt);
		transition: color 140ms var(--ease-out), border-color 140ms var(--ease-out);
	}

	.github-edit-btn:active {
		transform: scale(0.98);
	}

	@media (hover: hover) and (pointer: fine) {
		.github-edit-btn:hover {
			color: #111111;
			border-color: #111111;
			text-decoration: none;
		}
	}

	.post-h1 {
		font-family: var(--font-serif);
		font-size: clamp(2.4rem, 5.5vw, 3.6rem);
		line-height: 1.08;
		margin: 0;
		font-weight: 500;
		letter-spacing: -0.035em;
	}

	.post-lead {
		font-size: 1.12rem;
		line-height: 1.68;
		color: var(--text-body);
		margin: 0;
	}

	.hero-image {
		width: 100%;
		margin-bottom: 2rem;
	}

	.hero-img-el {
		width: 100%;
		height: auto;
		border-radius: 6px;
		border: 1px solid var(--border);
		box-shadow: var(--shadow-sm);
	}

	.prose {
		width: 100%;
		max-width: 100%;
		line-height: 1.75;
		font-size: 1.05rem;
		color: #111111;
	}

	.read-next-section {
		margin-top: 4rem;
		padding-top: 2.5rem;
		border-top: 1px solid var(--border);
		display: flex;
		flex-direction: column;
		gap: 1.25rem;
	}

	.read-next-title {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		margin: 0;
	}

	.read-next-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.25rem;
	}

	.read-next-card {
		background: var(--surface-card);
		border: 1px solid var(--border);
		border-radius: 6px;
		padding: 1.25rem;
		text-decoration: none;
		color: inherit;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		box-shadow: var(--shadow-sm);
		transition: border-color 140ms var(--ease-out), box-shadow 140ms var(--ease-out);
	}

	.read-next-card:active {
		transform: scale(0.98);
	}

	@media (hover: hover) and (pointer: fine) {
		.read-next-card:hover {
			border-color: var(--border-dark);
			box-shadow: var(--shadow-hover);
			text-decoration: none;
		}
	}

	.read-next-date {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--text-muted);
	}

	.read-next-card h4 {
		margin: 0;
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 500;
		line-height: 1.3;
		color: #111111;
	}

	.read-next-arrow {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		color: #111111;
		margin-top: auto;
		padding-top: 0.5rem;
	}

	@media (max-width: 680px) {
		.post-page {
			padding-top: 1.5rem;
		}

		.read-next-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
